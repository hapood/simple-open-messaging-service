{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:socfp:v1:http-parameters",
  "title": "Federation v1 normalized HTTP path/query parameter objects",
  "$defs": {
    "userProfileParameters": {
      "type": "object",
      "required": ["account"],
      "properties": {
        "account": {
          "$ref": "urn:socfp:v1:common#/$defs/userAccount"
        }
      },
      "additionalProperties": false
    },
    "feedQuery": {
      "type": "object",
      "dependentRequired": { "take": ["after"], "through": ["after"] },
      "properties": {
        "after": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        },
        "take": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
        "through": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    },
    "tombstoneFeedQuery": {
      "type": "object",
      "dependentRequired": { "take": ["after"], "through": ["after"] },
      "properties": {
        "after": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        },
        "take": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
        "through": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    },
    "messageFeedQuery": {
      "type": "object",
      "dependentRequired": { "take": ["after"], "through": ["after"] },
      "properties": {
        "after": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        },
        "take": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
        "through": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    },
    "threadDataQuery": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "account", "peerAccount"],
          "dependentRequired": { "take": ["after"], "through": ["after"] },
          "properties": {
            "type": { "const": "P2P" },
            "account": {
              "$ref": "urn:socfp:v1:common#/$defs/userAccount"
            },
            "peerAccount": {
              "$ref": "urn:socfp:v1:common#/$defs/userAccount"
            },
            "after": {
              "$ref": "urn:socfp:v1:common#/$defs/decimalString"
            },
            "through": {
              "$ref": "urn:socfp:v1:common#/$defs/decimalString"
            },
            "take": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
            "includeSelf": { "enum": ["true", "false"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "groupAccount", "groupDomain"],
          "dependentRequired": { "take": ["after"], "through": ["after"] },
          "properties": {
            "type": { "const": "GROUP" },
            "groupAccount": {
              "$ref": "urn:socfp:v1:common#/$defs/groupAccount"
            },
            "groupDomain": {
              "$ref": "urn:socfp:v1:common#/$defs/domain"
            },
            "after": {
              "$ref": "urn:socfp:v1:common#/$defs/decimalString"
            },
            "through": {
              "$ref": "urn:socfp:v1:common#/$defs/decimalString"
            },
            "take": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
            "includeSelf": { "enum": ["true", "false"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "mediaParameters": {
      "type": "object",
      "required": ["digest", "fromAccount", "fromDomain", "toAccount", "seq"],
      "properties": {
        "digest": { "$ref": "urn:socfp:v1:common#/$defs/sha256Hex" },
        "fromAccount": {
          "$ref": "urn:socfp:v1:common#/$defs/userAccount"
        },
        "fromDomain": { "$ref": "urn:socfp:v1:common#/$defs/domain" },
        "toAccount": { "$ref": "urn:socfp:v1:common#/$defs/account" },
        "seq": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        }
      },
      "additionalProperties": false
    },
    "forwardBundleParameters": {
      "type": "object",
      "required": ["bundleId"],
      "properties": {
        "bundleId": { "type": "string", "minLength": 1, "maxLength": 26 }
      },
      "additionalProperties": false
    }
  }
}
