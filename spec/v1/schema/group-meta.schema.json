{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:group-meta",
  "title": "GET /s2s/v1/group-meta response data",
  "$defs": {
    "feedId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "feedBoundary": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990,
      "description": "Published Group Meta end or scan boundary; SafeInteger is reserved for resumeBefore."
    },
    "upsertBody": {
      "type": "object",
      "required": ["account", "role", "namespaceId", "profileRev"],
      "properties": {
        "account": { "$ref": "urn:somfp:v1:common#/$defs/userAccount" },
        "role": { "enum": ["OWNER", "ADMIN", "MEMBER"] },
        "namespaceId": {
          "$ref": "urn:somfp:v1:common#/$defs/safeNonNegativeInteger"
        },
        "profileRev": {
          "$ref": "urn:somfp:v1:common#/$defs/safeNonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "profileBody": {
      "type": "object",
      "required": ["account", "namespaceId", "profileRev"],
      "properties": {
        "account": { "$ref": "urn:somfp:v1:common#/$defs/groupAccount" },
        "namespaceId": {
          "$ref": "urn:somfp:v1:common#/$defs/safeNonNegativeInteger"
        },
        "profileRev": {
          "$ref": "urn:somfp:v1:common#/$defs/safeNonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "announcementBody": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 4096 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "memberItemBase": {
      "type": "object",
      "required": ["feedId", "operation"],
      "properties": {
        "feedId": {
          "$ref": "#/$defs/feedId"
        },

        "operation": { "type": "string" }
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/memberItemBase",
          "required": ["body"],
          "properties": {
            "operation": { "const": "MEMBER_UPSERT" },
            "body": { "$ref": "#/$defs/upsertBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/memberItemBase",
          "required": ["body"],
          "properties": {
            "operation": { "const": "MEMBER_DEPART" },
            "body": { "$ref": "#/$defs/upsertBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["feedId", "operation", "body"],
          "properties": {
            "feedId": {
              "$ref": "#/$defs/feedId"
            },
            "operation": { "const": "GROUP_PROFILE" },
            "body": { "$ref": "#/$defs/profileBody" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["feedId", "operation", "body"],
          "properties": {
            "feedId": {
              "$ref": "#/$defs/feedId"
            },
            "operation": { "const": "GROUP_ANNOUNCEMENT" },
            "body": { "$ref": "#/$defs/announcementBody" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "account",
    "mode",
    "items",
    "scannedThrough",
    "groupMetaFeedEndId",
    "hasMore"
  ],
  "properties": {
    "account": { "$ref": "urn:somfp:v1:common#/$defs/groupAccount" },
    "mode": { "enum": ["full", "delta"] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "scannedThrough": {
      "$ref": "#/$defs/feedBoundary"
    },
    "groupMetaFeedEndId": {
      "$ref": "#/$defs/feedBoundary"
    },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
