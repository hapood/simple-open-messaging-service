{
  "protocol": "Simple Open Chat Federation Protocol",
  "majorVersion": 1,
  "s2sPrefix": "/s2s/v1",
  "discoveryPath": "/.well-known/socfp",
  "operations": [
    {
      "id": "wellKnown",
      "method": "GET",
      "path": "/.well-known/socfp",
      "authentication": "public-tls",
      "successStatus": [200],
      "responseMediaType": "application/json",
      "responseSchema": "urn:socfp:v1:discovery"
    },
    {
      "id": "recognize",
      "method": "POST",
      "path": "/s2s/v1/recognize",
      "authentication": "bootstrap-http-message-signature",
      "successStatus": [200],
      "requestMediaType": "application/json",
      "requestSchema": "urn:socfp:v1:identity#/$defs/recognizeRequest",
      "responseSchema": "urn:socfp:v1:identity#/$defs/recognizeOk"
    },
    {
      "id": "healthy",
      "method": "POST",
      "path": "/s2s/v1/healthy",
      "authentication": "status-http-message-signature",
      "successStatus": [200],
      "requestMediaType": "application/json",
      "requestSchema": "urn:socfp:v1:identity#/$defs/recognizeRequest",
      "responseSchema": "urn:socfp:v1:identity#/$defs/healthResult"
    },
    {
      "id": "feedHeads",
      "method": "POST",
      "path": "/s2s/v1/feed-heads",
      "authentication": "lightweight-http-message-signature",
      "successStatus": [200],
      "requestMediaType": "application/json",
      "requestSchema": "urn:socfp:v1:identity#/$defs/feedHeadHint"
    },
    {
      "id": "stateFeed",
      "method": "GET",
      "path": "/s2s/v1/state-feed",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200],
      "parameterSchema": "urn:socfp:v1:http-parameters#/$defs/feedQuery",
      "responseSchema": "urn:socfp:v1:state-feed",
      "responseEnvelope": true
    },
    {
      "id": "messageFeed",
      "method": "GET",
      "path": "/s2s/v1/message-feed",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200],
      "parameterSchema": "urn:socfp:v1:http-parameters#/$defs/messageFeedQuery",
      "responseSchema": "urn:socfp:v1:message-feed",
      "responseEnvelope": true
    },
    {
      "id": "groupMeta",
      "method": "GET",
      "path": "/s2s/v1/group-meta",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200],
      "parameterSchema": "urn:socfp:v1:http-parameters#/$defs/groupMetaQuery",
      "responseSchema": "urn:socfp:v1:group-meta",
      "responseEnvelope": true
    },
    {
      "id": "messageTombstoneFeed",
      "method": "GET",
      "path": "/s2s/v1/message-tombstone-feed",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200],
      "parameterSchema": "urn:socfp:v1:http-parameters#/$defs/tombstoneFeedQuery",
      "responseSchema": "urn:socfp:v1:message-tombstone-feed",
      "responseEnvelope": true
    },
    {
      "id": "messageQuery",
      "method": "GET",
      "path": "/s2s/v1/messages",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200],
      "parameterSchema": "urn:socfp:v1:http-parameters#/$defs/threadDataQuery",
      "responseSchema": "urn:socfp:v1:message-query",
      "responseEnvelope": true,
      "secondaryContentSchema": "urn:socfp:v1:message-content"
    },
    {
      "id": "messageTombstoneQuery",
      "method": "GET",
      "path": "/s2s/v1/message-tombstones",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200],
      "parameterSchema": "urn:socfp:v1:http-parameters#/$defs/threadDataQuery",
      "responseSchema": "urn:socfp:v1:message-tombstone-query",
      "responseEnvelope": true
    },
    {
      "id": "call",
      "method": "POST",
      "path": "/s2s/v1/call",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200],
      "requestMediaType": "application/json",
      "requestHeaders": [
        "Content-Type",
        "Date",
        "Content-Digest",
        "Signature-Input",
        "Signature"
      ],
      "requestSchema": "urn:socfp:v1:call",
      "responseEnvelope": true
    },
    {
      "id": "userProfile",
      "method": "GET",
      "path": "/s2s/v1/users/:account",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200],
      "parameterSchema": "urn:socfp:v1:http-parameters#/$defs/userProfileParameters",
      "requestHeaders": [
        "Date",
        "Content-Digest",
        "Signature-Input",
        "Signature"
      ],
      "responseSchema": "urn:socfp:v1:profile",
      "responseEnvelope": true
    },
    {
      "id": "media",
      "method": "GET",
      "path": "/s2s/v1/media/:digest",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200, 206],
      "parameterSchema": "urn:socfp:v1:http-parameters#/$defs/mediaParameters",
      "requestHeaders": [
        "Date",
        "Content-Digest",
        "Signature-Input",
        "Signature",
        "Range"
      ],
      "responseMediaType": "application/octet-stream",
      "responseHeaders": [
        "Content-Length",
        "Accept-Ranges",
        "Content-Range",
        "Content-Digest"
      ]
    },
    {
      "id": "forwardBundle",
      "method": "GET",
      "path": "/s2s/v1/forward-bundles/:bundleId",
      "authentication": "recognized-http-message-signature",
      "successStatus": [200],
      "parameterSchema": "urn:socfp:v1:http-parameters#/$defs/forwardBundleParameters",
      "requestHeaders": [
        "Date",
        "Content-Digest",
        "Signature-Input",
        "Signature"
      ],
      "responseSchema": "urn:socfp:v1:forward-bundle",
      "responseEnvelope": true
    }
  ],
  "errorSchema": "urn:socfp:v1:error"
}
