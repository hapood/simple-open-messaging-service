{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:identity",
  "title": "Federation v1 recognition and feed-head objects",
  "$defs": {
    "rotationProof": {
      "type": "object",
      "required": [
        "challenge",
        "claimedRoot",
        "created",
        "domain",
        "roots",
        "signature"
      ],
      "properties": {
        "challenge": {
          "$ref": "urn:somfp:v1:common#/$defs/base64UrlNonce"
        },
        "claimedRoot": {
          "$ref": "urn:somfp:v1:common#/$defs/base64Ed25519Key"
        },
        "created": {
          "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds"
        },
        "domain": {
          "$ref": "urn:somfp:v1:common#/$defs/domain"
        },
        "roots": {
          "$ref": "urn:somfp:v1:discovery#/$defs/rootGroup"
        },
        "signature": {
          "$ref": "urn:somfp:v1:common#/$defs/base64Ed25519Signature"
        }
      },
      "additionalProperties": false
    },
    "recognizeRequest": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0,
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["namespaceId"],
          "properties": {
            "namespaceId": {
              "$ref": "urn:somfp:v1:common#/$defs/positiveSafeInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["rotationProof"],
          "properties": {
            "rotationProof": { "$ref": "#/$defs/rotationProof" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["namespaceId", "rotationProof"],
          "properties": {
            "namespaceId": {
              "$ref": "urn:somfp:v1:common#/$defs/positiveSafeInteger"
            },
            "rotationProof": { "$ref": "#/$defs/rotationProof" }
          },
          "additionalProperties": false
        }
      ]
    },
    "recognizeResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "status"],
          "properties": {
            "ok": { "const": true },
            "status": { "const": "pending" },
            "challenge": {
              "$ref": "urn:somfp:v1:common#/$defs/base64UrlNonce"
            },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["ok", "status", "peerAssignedLocalNamespaceId"],
          "properties": {
            "ok": { "const": true },
            "status": { "const": "recognized" },
            "peerAssignedLocalNamespaceId": {
              "$ref": "urn:somfp:v1:common#/$defs/positiveSafeInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["ok", "status", "code", "message"],
          "properties": {
            "ok": { "const": false },
            "status": { "const": "failed" },
            "code": { "$ref": "urn:somfp:v1:common#/$defs/safeInteger" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "healthResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "peerAssignedLocalNamespaceId"],
          "properties": {
            "status": { "enum": ["available", "degraded"] },
            "peerAssignedLocalNamespaceId": {
              "$ref": "urn:somfp:v1:common#/$defs/positiveSafeInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "const": "unavailable" }
          },
          "additionalProperties": false
        }
      ]
    },
    "feedHeadHint": {
      "type": "object",
      "required": ["stateFeedEndId"],
      "properties": {
        "stateFeedEndId": {
          "$ref": "urn:somfp:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    }
  }
}
