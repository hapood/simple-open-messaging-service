{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:identity",
  "title": "Federation v1 recognition and feed-head objects",
  "$defs": {
    "recognizeRequest": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0,
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["namespaceId"],
          "properties": {
            "namespaceId": {
              "$ref": "urn:somfp:v1:common#/$defs/positiveSafeInteger"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "verifyRequest": {
      "type": "object",
      "required": ["publicKey", "encryptedValue"],
      "properties": {
        "publicKey": {
          "$ref": "urn:somfp:v1:common#/$defs/base64Ed25519Key"
        },
        "encryptedValue": {
          "$ref": "urn:somfp:v1:common#/$defs/base64SealedChallenge"
        }
      },
      "additionalProperties": false
    },
    "verifyResult": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "recognizeResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "status"],
          "properties": {
            "ok": {
              "const": true
            },
            "status": {
              "const": "pending"
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["ok", "status", "peerAssignedLocalNamespaceId"],
          "properties": {
            "ok": {
              "const": true
            },
            "status": {
              "const": "recognized"
            },
            "peerAssignedLocalNamespaceId": {
              "$ref": "urn:somfp:v1:common#/$defs/positiveSafeInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["ok", "status", "code", "message"],
          "properties": {
            "ok": {
              "const": false
            },
            "status": {
              "const": "failed"
            },
            "code": {
              "$ref": "urn:somfp:v1:common#/$defs/safeInteger"
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "healthResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "peerAssignedLocalNamespaceId"],
          "properties": {
            "status": {
              "enum": ["available", "degraded"]
            },
            "peerAssignedLocalNamespaceId": {
              "$ref": "urn:somfp:v1:common#/$defs/positiveSafeInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "feedHeadHint": {
      "type": "object",
      "required": ["stateFeedEndId", "profileNamespaceFeedEndId"],
      "properties": {
        "stateFeedEndId": {
          "$ref": "urn:somfp:v1:common#/$defs/decimalString"
        },
        "profileNamespaceFeedEndId": {
          "$ref": "urn:somfp:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    }
  }
}
