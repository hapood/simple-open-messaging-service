{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:identity",
  "title": "Federation v1 recognition and feed-head objects",
  "$defs": {
    "recognizeRequest": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "recognizeOk": {
      "type": "object",
      "required": ["ok"],
      "properties": { "ok": { "const": true } },
      "additionalProperties": false
    },
    "healthResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "degraded", "unavailable"] }
      },
      "additionalProperties": false
    },
    "feedHeadHint": {
      "type": "object",
      "required": ["stateFeedEndId", "messageFeedEndId", "tombstoneFeedEndId"],
      "properties": {
        "stateFeedEndId": {
          "$ref": "urn:somfp:v1:common#/$defs/decimalString"
        },
        "messageFeedEndId": {
          "$ref": "urn:somfp:v1:common#/$defs/decimalString"
        },
        "tombstoneFeedEndId": {
          "$ref": "urn:somfp:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    }
  }
}
