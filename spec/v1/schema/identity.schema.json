{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:socfp:v1:identity",
  "title": "Federation v1 recognition and feed revision objects",
  "$defs": {
    "recognizeRequest": {
      "type": "object",
      "required": ["domain"],
      "properties": {
        "domain": { "$ref": "urn:socfp:v1:common#/$defs/domain" }
      },
      "additionalProperties": false
    },
    "recognizeOk": {
      "type": "object",
      "required": ["ok"],
      "properties": { "ok": { "const": true } },
      "additionalProperties": false
    },
    "v1DiscoveryResult": {
      "type": "object",
      "required": ["extensions"],
      "properties": {
        "extensions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:socfp:v1:common#/$defs/extensionId"
          }
        },
        "software": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "v1DiscoveryRequest": {
      "type": "object",
      "required": ["origin"],
      "properties": {
        "origin": { "$ref": "urn:socfp:v1:common#/$defs/domain" }
      },
      "additionalProperties": false
    },
    "healthResult": {
      "type": "object",
      "required": [
        "status",
        "selectedProtocolVersion",
        "acceptedExtensions"
      ],
      "properties": {
        "status": { "enum": ["available", "degraded", "unavailable"] },
        "selectedProtocolVersion": {
          "oneOf": [
            { "$ref": "urn:socfp:v1:common#/$defs/positiveSafeInteger" },
            { "type": "null" }
          ]
        },
        "acceptedExtensions": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "urn:socfp:v1:common#/$defs/extensionId"
              }
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unavailable" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "selectedProtocolVersion": { "type": "null" },
              "acceptedExtensions": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "selectedProtocolVersion": {
                "$ref": "urn:socfp:v1:common#/$defs/positiveSafeInteger"
              },
              "acceptedExtensions": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "$ref": "urn:socfp:v1:common#/$defs/extensionId"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "feedHeadHint": {
      "type": "object",
      "required": [
        "origin",
        "stateFeedEndId",
        "messageFeedEndId",
        "tombstoneFeedEndId"
      ],
      "properties": {
        "origin": { "$ref": "urn:socfp:v1:common#/$defs/domain" },
        "stateFeedEndId": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        },
        "messageFeedEndId": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        },
        "tombstoneFeedEndId": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        },
        "extensions": { "$ref": "urn:socfp:v1:common#/$defs/extensions" }
      },
      "additionalProperties": false
    }
  }
}
