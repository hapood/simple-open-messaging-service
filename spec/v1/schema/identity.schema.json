{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:identity",
  "title": "Federation v1 recognition and feed revision objects",
  "$defs": {
    "recognizeRequest": {
      "type": "object",
      "required": ["domain"],
      "properties": {
        "domain": { "$ref": "urn:soms:federation:v1:common#/$defs/domain" }
      },
      "additionalProperties": false
    },
    "recognizeOk": {
      "type": "object",
      "required": ["ok"],
      "properties": { "ok": { "const": true } },
      "additionalProperties": false
    },
    "healthResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "degraded", "unavailable"] }
      },
      "additionalProperties": false
    },
    "feedHeadHint": {
      "type": "object",
      "required": [
        "origin",
        "stateFeedEndId",
        "messageFeedEndId",
        "tombstoneFeedEndId"
      ],
      "properties": {
        "origin": { "$ref": "urn:soms:federation:v1:common#/$defs/domain" },
        "stateFeedEndId": {
          "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
        },
        "messageFeedEndId": {
          "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
        },
        "tombstoneFeedEndId": {
          "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    }
  }
}
