{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:call",
  "title": "POST /s2s/v1/call request",
  "$defs": {
    "base": {
      "type": "object",
      "required": ["callSid", "op", "callType"],
      "properties": {
        "callSid": { "$ref": "urn:somfp:v1:common#/$defs/callSid" },
        "op": { "type": "string" },
        "callType": { "enum": ["AUDIO", "VIDEO"] }
      }
    },
    "signalKind": {
      "enum": ["offer", "answer", "ice", "video-state"]
    },
    "signalPayload": {
      "type": "object",
      "required": ["id", "kind", "data"],
      "properties": {
        "id": { "$ref": "urn:somfp:v1:common#/$defs/canonicalUuid" },
        "kind": { "$ref": "#/$defs/signalKind" },
        "data": { "type": "string", "minLength": 1, "maxLength": 32768 }
      },
      "additionalProperties": false
    },
    "endReason": {
      "enum": ["completed", "timeout", "failed"]
    }
  },
  "oneOf": [
    {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["payload"],
          "properties": {
            "op": { "const": "incoming" },
            "payload": {
              "type": "object",
              "required": ["fromAccount", "toAccount"],
              "properties": {
                "fromAccount": {
                  "$ref": "urn:somfp:v1:common#/$defs/account"
                },
                "toAccount": {
                  "$ref": "urn:somfp:v1:common#/$defs/account"
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "op": {
              "enum": ["accepted", "ringing", "declined", "cancelled", "missed"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["payload"],
          "properties": {
            "op": { "const": "signal" },
            "payload": { "$ref": "#/$defs/signalPayload" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["payload"],
          "properties": {
            "op": { "const": "connected" },
            "payload": {
              "type": "object",
              "required": ["startedAt"],
              "properties": {
                "startedAt": {
                  "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds"
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "op": { "const": "video-upgraded" },
            "callType": { "const": "VIDEO" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["payload"],
          "properties": {
            "op": { "const": "ended" },
            "payload": {
              "type": "object",
              "required": ["endReason"],
              "properties": {
                "endReason": { "$ref": "#/$defs/endReason" }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  ]
}
