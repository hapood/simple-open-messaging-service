{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:profile",
  "title": "GET /s2s/v1/users/:account response data",
  "type": "object",
  "required": [
    "account",
    "domain",
    "displayName",
    "bio",
    "avatar",
    "profileRev"
  ],
  "properties": {
    "account": {
      "$ref": "urn:somfp:v1:common#/$defs/userAccount"
    },
    "domain": { "$ref": "urn:somfp:v1:common#/$defs/domain" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 30 },
    "bio": { "type": "string", "maxLength": 120 },
    "avatar": {
      "oneOf": [
        { "$ref": "urn:somfp:v1:common#/$defs/inlineProfileAvatar" },
        { "type": "null" }
      ]
    },
    "profileRev": {
      "$ref": "urn:somfp:v1:common#/$defs/safeNonNegativeInteger"
    }
  },
  "additionalProperties": false
}
