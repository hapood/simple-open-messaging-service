{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:profile",
  "title": "GET /s2s/v1/accounts/:account response data",
  "type": "object",
  "required": ["account", "generatedAt", "profileRev", "profile", "proof"],
  "properties": {
    "account": { "$ref": "urn:somfp:v1:common#/$defs/account" },
    "generatedAt": { "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds" },
    "profileRev": {
      "$ref": "urn:somfp:v1:common#/$defs/safeNonNegativeInteger"
    },
    "profile": {
      "oneOf": [{ "$ref": "#/$defs/profileContent" }, { "type": "null" }]
    },
    "proof": { "$ref": "urn:somfp:v1:common#/$defs/base64ChallengeAnswer" }
  },
  "allOf": [
    {
      "if": { "properties": { "profileRev": { "const": 0 } } },
      "then": {
        "properties": {
          "profile": { "type": "null" },
          "generatedAt": { "const": 0 }
        }
      },
      "else": {
        "properties": { "profile": { "$ref": "#/$defs/profileContent" } }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "profileContent": {
      "type": "object",
      "required": ["displayName", "bio", "avatar"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 31 },
        "bio": { "type": "string", "maxLength": 120 },
        "avatar": {
          "oneOf": [
            { "$ref": "urn:somfp:v1:common#/$defs/inlineProfileAvatar" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
