{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:profile",
  "title": "GET /s2s/v1/users/:account response data",
  "type": "object",
  "required": ["account", "domain", "displayName", "avatar", "profileRev"],
  "properties": {
    "account": {
      "$ref": "urn:soms:federation:v1:common#/$defs/userAccount"
    },
    "domain": { "$ref": "urn:soms:federation:v1:common#/$defs/domain" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 30 },
    "avatar": {
      "oneOf": [
        {
          "type": "object",
          "required": ["b64", "w", "h"],
          "properties": {
            "b64": {
              "type": "string",
              "minLength": 4,
              "maxLength": 1048576,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "w": {
              "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
            },
            "h": {
              "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
            }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "profileRev": {
      "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
    }
  },
  "additionalProperties": false
}
