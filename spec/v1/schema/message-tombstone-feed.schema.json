{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:message-tombstone-feed",
  "title": "GET /s2s/v1/message-tombstone-feed response data",
  "$defs": {
    "thread": { "$ref": "urn:somfp:v1:message-feed#/$defs/thread" },
    "item": {
      "type": "object",
      "required": ["feedId", "thread", "tombstoneEndSeq"],
      "properties": {
        "feedId": {
          "$ref": "urn:somfp:v1:common#/$defs/positiveDecimalString"
        },
        "thread": { "$ref": "#/$defs/thread" },
        "tombstoneEndSeq": {
          "$ref": "urn:somfp:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["items", "scannedThrough", "tombstoneFeedEndId", "hasMore"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "scannedThrough": {
      "$ref": "urn:somfp:v1:common#/$defs/decimalString"
    },
    "tombstoneFeedEndId": {
      "$ref": "urn:somfp:v1:common#/$defs/decimalString"
    },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
