{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:discovery",
  "title": "GET /.well-known/soms response for a v1-capable node",
  "type": "object",
  "required": ["protocolVersions", "rootKey", "keys"],
  "properties": {
    "software": { "type": "string", "minLength": 1, "maxLength": 128 },
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": 1 },
      "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
    },
    "rootKey": {
      "type": "object",
      "required": ["ed25519"],
      "properties": {
        "ed25519": {
          "$ref": "urn:soms:federation:v1:common#/$defs/base64Ed25519Key"
        }
      },
      "additionalProperties": false
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "keyId",
          "ed25519",
          "notBefore",
          "notAfter",
          "authorizationSignature"
        ],
        "properties": {
          "keyId": { "type": "string", "minLength": 3 },
          "ed25519": {
            "$ref": "urn:soms:federation:v1:common#/$defs/base64Ed25519Key"
          },
          "notBefore": {
            "$ref": "urn:soms:federation:v1:common#/$defs/epochMilliseconds"
          },
          "notAfter": {
            "$ref": "urn:soms:federation:v1:common#/$defs/epochMilliseconds"
          },
          "authorizationSignature": {
            "$ref": "urn:soms:federation:v1:common#/$defs/base64Ed25519Signature"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
