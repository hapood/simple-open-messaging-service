{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:message-tombstone-query",
  "title": "GET /s2s/v1/message-tombstones response data",
  "$defs": {
    "tombstone": {
      "type": "object",
      "required": ["deletionSeq", "thread", "messageSeq", "type", "deletedAt"],
      "properties": {
        "deletionSeq": {
          "$ref": "urn:somfp:v1:common#/$defs/positiveDecimalString"
        },
        "thread": {
          "$ref": "urn:somfp:v1:message-feed#/$defs/thread"
        },
        "messageSeq": {
          "$ref": "urn:somfp:v1:common#/$defs/positiveThreadSequence"
        },
        "type": { "enum": ["WITHDRAW", "REPORT"] },
        "deletedAt": {
          "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["tombstones", "scannedThrough", "hasMore"],
  "properties": {
    "tombstones": { "type": "array", "items": { "$ref": "#/$defs/tombstone" } },
    "scannedThrough": {
      "$ref": "urn:somfp:v1:common#/$defs/decimalString"
    },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
