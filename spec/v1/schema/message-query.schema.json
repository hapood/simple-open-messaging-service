{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:message-query",
  "title": "GET /s2s/v1/messages response data",
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["digest", "bytes"],
      "properties": {
        "digest": { "$ref": "urn:somfp:v1:common#/$defs/sha256Hex" },
        "bytes": {
          "$ref": "urn:somfp:v1:common#/$defs/safeNonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": [
        "thread",
        "author",
        "seq",
        "originSeq",
        "originCreatedAt",
        "contentType",
        "content",
        "createdAt",
        "assets"
      ],
      "properties": {
        "thread": {
          "$ref": "urn:somfp:v1:message-feed#/$defs/thread"
        },
        "author": { "$ref": "urn:somfp:v1:common#/$defs/address" },
        "seq": {
          "$ref": "urn:somfp:v1:common#/$defs/positiveThreadSequence"
        },
        "originSeq": {
          "oneOf": [
            {
              "$ref": "urn:somfp:v1:common#/$defs/positiveThreadSequence"
            },
            { "type": "null" }
          ]
        },
        "originCreatedAt": {
          "oneOf": [
            {
              "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds"
            },
            { "type": "null" }
          ]
        },
        "contentType": {
          "$ref": "urn:somfp:v1:common#/$defs/contentType"
        },
        "content": { "type": "string", "minLength": 2 },
        "createdAt": {
          "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds"
        },
        "quoteTarget": {
          "type": "object",
          "required": ["targetSeq"],
          "properties": {
            "targetSeq": {
              "$ref": "urn:somfp:v1:common#/$defs/positiveThreadSequence"
            }
          },
          "additionalProperties": false
        },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["messages", "scannedThrough", "hasMore"],
  "properties": {
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "scannedThrough": {
      "$ref": "urn:somfp:v1:common#/$defs/decimalString"
    },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
