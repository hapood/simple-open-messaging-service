{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:message-content",
  "title": "Parsed Federation v1 message content selected by contentType",
  "$defs": {
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "text": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "quote": {
          "type": "object",
          "required": ["seq"],
          "properties": {
            "seq": {
              "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
            },
            "author": { "type": "string" },
            "body": { "type": "string" },
            "contentType": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["digest", "w", "h", "size"],
      "properties": {
        "digest": { "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex" },
        "w": {
          "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
        },
        "h": {
          "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
        },
        "size": {
          "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["digest", "name", "size", "mimeType"],
      "properties": {
        "digest": { "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex" },
        "name": { "type": "string", "minLength": 1 },
        "size": {
          "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
        },
        "mimeType": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "required": ["digest", "name", "size", "mimeType", "w", "h", "duration"],
      "properties": {
        "digest": { "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex" },
        "name": { "type": "string", "minLength": 1 },
        "size": {
          "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
        },
        "mimeType": { "type": "string", "minLength": 1 },
        "w": {
          "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
        },
        "h": {
          "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
        },
        "duration": { "$ref": "#/$defs/positiveNumber" }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "required": ["digest", "name", "size", "mimeType", "duration"],
      "properties": {
        "digest": { "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex" },
        "name": { "type": "string", "minLength": 1 },
        "size": {
          "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
        },
        "mimeType": { "type": "string", "minLength": 1 },
        "duration": { "$ref": "#/$defs/positiveNumber" }
      },
      "additionalProperties": false
    },
    "galleryItem": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "digest", "size", "w", "h"],
          "properties": {
            "kind": { "const": "IMAGE" },
            "digest": {
              "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex"
            },
            "size": {
              "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
            },
            "w": {
              "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
            },
            "h": {
              "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "digest",
            "size",
            "name",
            "mimeType",
            "w",
            "h",
            "duration"
          ],
          "properties": {
            "kind": { "const": "VIDEO" },
            "digest": {
              "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex"
            },
            "size": {
              "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
            },
            "name": { "type": "string" },
            "mimeType": { "type": "string" },
            "w": {
              "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
            },
            "h": {
              "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
            },
            "duration": { "$ref": "#/$defs/positiveNumber" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "digest",
            "size",
            "name",
            "mimeType",
            "duration"
          ],
          "properties": {
            "kind": { "const": "AUDIO" },
            "digest": {
              "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex"
            },
            "size": {
              "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
            },
            "name": { "type": "string" },
            "mimeType": { "type": "string" },
            "duration": { "$ref": "#/$defs/positiveNumber" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "digest", "size", "name", "mimeType"],
          "properties": {
            "kind": { "const": "FILE" },
            "digest": {
              "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex"
            },
            "size": {
              "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
            },
            "name": { "type": "string" },
            "mimeType": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "gallery": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/galleryItem" }
        }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["url", "title", "description"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "siteName": { "type": "string" },
        "imageDigest": {
          "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex"
        },
        "faviconDigest": {
          "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex"
        }
      },
      "additionalProperties": false
    },
    "invite": {
      "type": "object",
      "required": ["type", "from", "group", "groupName", "groupDomain"],
      "properties": {
        "type": { "const": "GROUP_INVITE" },
        "from": { "$ref": "urn:soms:federation:v1:common#/$defs/userAccount" },
        "group": {
          "$ref": "urn:soms:federation:v1:common#/$defs/groupAccount"
        },
        "groupName": { "type": "string" },
        "groupDomain": {
          "$ref": "urn:soms:federation:v1:common#/$defs/domain"
        }
      },
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "required": ["type", "callType", "status", "caller", "callee", "endedAt"],
      "properties": {
        "type": { "const": "CALL" },
        "callType": { "enum": ["AUDIO", "VIDEO"] },
        "status": {
          "enum": [
            "completed",
            "cancelled",
            "declined",
            "missed",
            "failed",
            "unreachable"
          ]
        },
        "caller": { "$ref": "urn:soms:federation:v1:common#/$defs/address" },
        "callee": { "$ref": "urn:soms:federation:v1:common#/$defs/address" },
        "startedAt": {
          "$ref": "urn:soms:federation:v1:common#/$defs/epochMilliseconds"
        },
        "endedAt": {
          "$ref": "urn:soms:federation:v1:common#/$defs/epochMilliseconds"
        },
        "durationMs": {
          "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
        }
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["startedAt", "durationMs"] },
            {
              "not": {
                "anyOf": [
                  { "required": ["startedAt"] },
                  { "required": ["durationMs"] }
                ]
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["cancelled", "declined", "missed", "unreachable"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["startedAt"] },
                { "required": ["durationMs"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "forward": {
      "type": "object",
      "required": [
        "version",
        "bundleId",
        "summaryLines",
        "messageCount",
        "assetCount"
      ],
      "properties": {
        "version": { "const": 1 },
        "bundleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 26,
          "pattern": "^[^/\\u0000]+$"
        },
        "summaryLines": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "messageCount": {
          "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
        },
        "assetCount": {
          "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["contentType", "content"],
  "properties": {
    "contentType": {
      "enum": [
        "PURE_TEXT",
        "INVITE",
        "IMAGE",
        "VIDEO",
        "FILE",
        "AUDIO",
        "LINK",
        "CALL",
        "FORWARD",
        "GALLERY"
      ]
    },
    "content": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "contentType": { "const": "PURE_TEXT" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/text" } } }
    },
    {
      "if": { "properties": { "contentType": { "const": "INVITE" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/invite" } } }
    },
    {
      "if": { "properties": { "contentType": { "const": "IMAGE" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/image" } } }
    },
    {
      "if": { "properties": { "contentType": { "const": "VIDEO" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/video" } } }
    },
    {
      "if": { "properties": { "contentType": { "const": "FILE" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/file" } } }
    },
    {
      "if": { "properties": { "contentType": { "const": "AUDIO" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/audio" } } }
    },
    {
      "if": { "properties": { "contentType": { "const": "LINK" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/link" } } }
    },
    {
      "if": { "properties": { "contentType": { "const": "CALL" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/call" } } }
    },
    {
      "if": { "properties": { "contentType": { "const": "FORWARD" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/forward" } } }
    },
    {
      "if": { "properties": { "contentType": { "const": "GALLERY" } } },
      "then": { "properties": { "content": { "$ref": "#/$defs/gallery" } } }
    }
  ],
  "additionalProperties": false
}
