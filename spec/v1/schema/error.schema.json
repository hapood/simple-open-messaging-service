{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:error",
  "title": "Federation v1 JSON error envelope",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "enum": [
        10000, 10001, 10004, 10005, 10999, 50001, 50002, 50003, 50007, 50009,
        50010, 50011, 50012, 50013, 50014, 50015, 50019, 50020, 50021, 50023,
        50024, 50025, 70001, 70004, 70007, 70008
      ]
    },
    "message": { "type": "string" },
    "data": true
  },
  "additionalProperties": true,
  "oneOf": [
    {
      "properties": {
        "code": { "const": 50011 },
        "data": { "$ref": "#/$defs/quotaExceededData" }
      },
      "required": ["data"]
    },
    {
      "properties": {
        "code": { "const": 50013 },
        "data": { "$ref": "#/$defs/capabilityDisabledData" }
      },
      "required": ["data"]
    },
    {
      "properties": {
        "code": { "const": 50019 },
        "data": { "$ref": "#/$defs/feedCursorUnavailableData" }
      },
      "required": ["data"]
    },
    {
      "properties": {
        "code": { "enum": [50024, 50025] },
        "data": { "$ref": "#/$defs/queryRetryData" }
      },
      "required": ["data"]
    },
    {
      "properties": {
        "code": {
          "not": { "enum": [50011, 50013, 50019, 50024, 50025] }
        },
        "data": { "type": "null" }
      }
    }
  ],
  "$defs": {
    "quotaCategory": {
      "enum": ["messages", "files", "requests", "signals"]
    },
    "quotaExceededData": {
      "type": "object",
      "required": ["retryAfter"],
      "properties": {
        "retryAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "capabilityDisabledData": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/quotaCategory" }
      },
      "additionalProperties": false
    },
    "feedCursorUnavailableData": {
      "type": "object",
      "required": ["resumeAfter"],
      "properties": {
        "resumeAfter": {
          "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    },
    "queryRetryData": {
      "type": "object",
      "required": ["retryAfter"],
      "properties": {
        "retryAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  }
}
