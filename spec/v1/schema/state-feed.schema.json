{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:state-feed",
  "title": "GET /s2s/v1/state-feed response data",
  "$defs": {
    "avatar": {
      "type": "object",
      "required": ["digest", "mimeType", "base64", "width", "height"],
      "properties": {
        "digest": { "$ref": "urn:somfp:v1:common#/$defs/sha256Hex" },
        "mimeType": { "type": "string", "minLength": 1 },
        "base64": { "type": "string", "minLength": 4, "maxLength": 1048576 },
        "width": { "$ref": "urn:somfp:v1:common#/$defs/positiveSafeInteger" },
        "height": { "$ref": "urn:somfp:v1:common#/$defs/positiveSafeInteger" }
      },
      "additionalProperties": false
    },
    "profileBody": {
      "type": "object",
      "required": ["profileRev", "displayName", "bio", "avatar"],
      "properties": {
        "profileRev": {
          "$ref": "urn:somfp:v1:common#/$defs/safeNonNegativeInteger"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 120 },
        "avatar": {
          "oneOf": [{ "$ref": "#/$defs/avatar" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "REQUESTED" } } },
          "then": {
            "properties": {
              "requestedAt": {
                "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds"
              },
              "expiresAt": {
                "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds"
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "ACCEPTED" } } },
          "then": {
            "properties": {
              "requestedAt": {
                "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds"
              },
              "expiresAt": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "REVOKED" } } },
          "then": { "properties": { "expiresAt": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "relationshipIntentBody": {
      "type": "object",
      "required": ["status", "note", "requestedAt", "expiresAt"],
      "properties": {
        "status": { "enum": ["REQUESTED", "ACCEPTED", "REVOKED"] },
        "note": { "type": "string", "maxLength": 255 },
        "requestedAt": {
          "oneOf": [
            { "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds" },
            { "type": "null" }
          ]
        },
        "expiresAt": {
          "oneOf": [
            { "$ref": "urn:somfp:v1:common#/$defs/epochMilliseconds" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "groupMetaFeedHeadBody": {
      "type": "object",
      "required": ["groupMetaFeedEndId"],
      "properties": {
        "groupMetaFeedEndId": {
          "$ref": "urn:somfp:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    },
    "itemBase": {
      "type": "object",
      "required": ["account", "domain", "eventType", "feedId", "body"],
      "properties": {
        "account": { "$ref": "urn:somfp:v1:common#/$defs/account" },
        "domain": { "$ref": "urn:somfp:v1:common#/$defs/domain" },
        "eventType": { "type": "string" },
        "feedId": {
          "$ref": "urn:somfp:v1:common#/$defs/positiveDecimalString"
        },
        "body": { "type": "object" }
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "eventType": { "const": "PROFILE" },
            "body": { "$ref": "#/$defs/profileBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "eventType": { "const": "RELATIONSHIP_INTENT" },
            "localAccount": { "$ref": "urn:somfp:v1:common#/$defs/account" },
            "body": { "$ref": "#/$defs/relationshipIntentBody" }
          },
          "required": ["localAccount"],
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "account": { "$ref": "urn:somfp:v1:common#/$defs/groupAccount" },
            "eventType": { "const": "GROUP_META_FEED_HEAD" },
            "body": { "$ref": "#/$defs/groupMetaFeedHeadBody" }
          },
          "unevaluatedProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": ["items", "scannedThrough", "stateFeedEndId", "hasMore"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "scannedThrough": { "$ref": "urn:somfp:v1:common#/$defs/decimalString" },
    "stateFeedEndId": { "$ref": "urn:somfp:v1:common#/$defs/decimalString" },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
