{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:socfp:v1:state-feed",
  "title": "GET /s2s/v1/state-feed response data",
  "$defs": {
    "profileAvatar": {
      "type": "object",
      "required": ["digest", "mimeType", "base64", "width", "height"],
      "properties": {
        "digest": { "$ref": "urn:socfp:v1:common#/$defs/sha256Hex" },
        "mimeType": { "type": "string", "minLength": 1 },
        "base64": { "type": "string", "minLength": 4, "maxLength": 1048576 },
        "width": {
          "$ref": "urn:socfp:v1:common#/$defs/positiveSafeInteger"
        },
        "height": {
          "$ref": "urn:socfp:v1:common#/$defs/positiveSafeInteger"
        }
      },
      "additionalProperties": false
    },
    "intentProperties": {
      "status": { "enum": ["REQUESTED", "ACCEPTED", "REVOKED"] },
      "note": { "type": "string" },
      "requestedAt": {
        "oneOf": [
          { "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds" },
          { "type": "null" }
        ]
      },
      "expiresAt": {
        "oneOf": [
          { "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds" },
          { "type": "null" }
        ]
      }
    },
    "profileBody": {
      "type": "object",
      "required": ["displayName", "bio", "avatar", "deleted"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "bio": { "type": "string" },
        "avatar": {
          "oneOf": [{ "$ref": "#/$defs/profileAvatar" }, { "type": "null" }]
        },
        "deleted": { "type": "boolean" },
        "extensions": { "$ref": "urn:socfp:v1:common#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "memberProfileBody": {
      "type": "object",
      "required": ["displayName", "avatar"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "avatar": {
          "oneOf": [{ "$ref": "#/$defs/profileAvatar" }, { "type": "null" }]
        },
        "extensions": { "$ref": "urn:socfp:v1:common#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "p2pIntentBody": {
      "type": "object",
      "required": ["status", "note", "requestedAt", "expiresAt"],
      "properties": {
        "status": { "enum": ["REQUESTED", "ACCEPTED", "REVOKED"] },
        "note": { "type": "string" },
        "requestedAt": {
          "oneOf": [
            {
              "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds"
            },
            { "type": "null" }
          ]
        },
        "expiresAt": {
          "oneOf": [
            {
              "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds"
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "REQUESTED" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "requestedAt": { "type": "integer" },
              "expiresAt": { "type": "integer" }
            }
          },
          "else": { "properties": { "expiresAt": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "groupInviteIntentBody": {
      "type": "object",
      "required": ["status", "note", "requestedAt", "expiresAt", "owner"],
      "properties": {
        "status": { "enum": ["REQUESTED", "ACCEPTED", "REVOKED"] },
        "note": { "type": "string" },
        "requestedAt": {
          "oneOf": [
            {
              "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds"
            },
            { "type": "null" }
          ]
        },
        "expiresAt": {
          "oneOf": [
            {
              "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds"
            },
            { "type": "null" }
          ]
        },
        "owner": { "$ref": "urn:socfp:v1:common#/$defs/address" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "REQUESTED" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "requestedAt": { "type": "integer" },
              "expiresAt": { "type": "integer" }
            }
          },
          "else": { "properties": { "expiresAt": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "groupJoinIntentBody": {
      "type": "object",
      "required": ["status", "note", "requestedAt", "expiresAt"],
      "properties": {
        "status": { "enum": ["REQUESTED", "ACCEPTED", "REVOKED"] },
        "note": { "type": "string" },
        "requestedAt": {
          "oneOf": [
            {
              "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds"
            },
            { "type": "null" }
          ]
        },
        "expiresAt": {
          "oneOf": [
            {
              "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds"
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "REQUESTED" } },
            "required": ["status"]
          },
          "then": { "properties": { "requestedAt": { "type": "integer" } } },
          "else": { "properties": { "expiresAt": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "groupMetaBody": {
      "type": "object",
      "required": [
        "active",
        "dissolved",
        "owner",
        "membersCanInvite",
        "members"
      ],
      "properties": {
        "active": { "type": "boolean" },
        "dissolved": { "type": "boolean" },
        "owner": {
          "oneOf": [
            { "$ref": "urn:socfp:v1:common#/$defs/address" },
            { "type": "null" }
          ]
        },
        "membersCanInvite": { "type": "boolean" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["account", "domain", "role"],
            "properties": {
              "account": {
                "$ref": "urn:socfp:v1:common#/$defs/userAccount"
              },
              "domain": {
                "$ref": "urn:socfp:v1:common#/$defs/domain"
              },
              "role": { "enum": ["OWNER", "ADMIN", "MEMBER"] }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "dissolved": { "const": true } },
            "required": ["dissolved"]
          },
          "then": {
            "properties": {
              "active": { "const": false },
              "owner": { "type": "null" },
              "members": { "maxItems": 0 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "itemBase": {
      "type": "object",
      "required": [
        "account",
        "domain",
        "eventType",
        "subjectAccount",
        "subjectDomain",
        "revision",
        "feedId",
        "body"
      ],
      "properties": {
        "account": { "$ref": "urn:socfp:v1:common#/$defs/account" },
        "domain": { "$ref": "urn:socfp:v1:common#/$defs/domain" },
        "eventType": { "type": "string" },
        "subjectAccount": { "type": "string" },
        "subjectDomain": { "type": "string" },
        "revision": {
          "$ref": "urn:socfp:v1:common#/$defs/decimalString"
        },
        "feedId": {
          "$ref": "urn:socfp:v1:common#/$defs/positiveDecimalString"
        },
        "body": { "type": "object" }
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "eventType": { "const": "PROFILE" },
            "subjectAccount": { "const": "" },
            "subjectDomain": { "const": "" },
            "body": { "$ref": "#/$defs/profileBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "account": {
              "$ref": "urn:socfp:v1:common#/$defs/userAccount"
            },
            "eventType": { "const": "MEMBER_PROFILE" },
            "subjectAccount": { "const": "" },
            "subjectDomain": { "const": "" },
            "body": { "$ref": "#/$defs/memberProfileBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "account": {
              "$ref": "urn:socfp:v1:common#/$defs/userAccount"
            },
            "eventType": { "const": "P2P_INTENT" },
            "subjectAccount": {
              "$ref": "urn:socfp:v1:common#/$defs/userAccount"
            },
            "subjectDomain": {
              "$ref": "urn:socfp:v1:common#/$defs/domain"
            },
            "body": { "$ref": "#/$defs/p2pIntentBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "account": {
              "$ref": "urn:socfp:v1:common#/$defs/groupAccount"
            },
            "eventType": { "const": "GROUP_INVITE_INTENT" },
            "subjectAccount": {
              "$ref": "urn:socfp:v1:common#/$defs/userAccount"
            },
            "subjectDomain": {
              "$ref": "urn:socfp:v1:common#/$defs/domain"
            },
            "body": { "$ref": "#/$defs/groupInviteIntentBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "account": {
              "$ref": "urn:socfp:v1:common#/$defs/groupAccount"
            },
            "eventType": { "const": "GROUP_JOIN_INTENT" },
            "subjectAccount": {
              "$ref": "urn:socfp:v1:common#/$defs/userAccount"
            },
            "subjectDomain": {
              "$ref": "urn:socfp:v1:common#/$defs/domain"
            },
            "body": { "$ref": "#/$defs/groupJoinIntentBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "account": {
              "$ref": "urn:socfp:v1:common#/$defs/groupAccount"
            },
            "eventType": { "const": "GROUP_META" },
            "subjectAccount": { "const": "" },
            "subjectDomain": { "const": "" },
            "body": { "$ref": "#/$defs/groupMetaBody" }
          },
          "unevaluatedProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": ["items", "scannedThrough", "stateFeedEndId", "hasMore"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "scannedThrough": {
      "$ref": "urn:socfp:v1:common#/$defs/decimalString"
    },
    "stateFeedEndId": {
      "$ref": "urn:socfp:v1:common#/$defs/decimalString"
    },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
