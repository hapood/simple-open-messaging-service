{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:socfp:v1:state-feed",
  "title": "GET /s2s/v1/state-feed response data",
  "$defs": {
    "profileAvatar": {
      "type": "object",
      "required": ["digest", "mimeType", "base64", "width", "height"],
      "properties": {
        "digest": { "$ref": "urn:socfp:v1:common#/$defs/sha256Hex" },
        "mimeType": { "type": "string", "minLength": 1 },
        "base64": { "type": "string", "minLength": 4, "maxLength": 1048576 },
        "width": {
          "$ref": "urn:socfp:v1:common#/$defs/positiveSafeInteger"
        },
        "height": {
          "$ref": "urn:socfp:v1:common#/$defs/positiveSafeInteger"
        }
      },
      "additionalProperties": false
    },
    "intentProperties": {
      "status": { "enum": ["REQUESTED", "ACCEPTED", "REVOKED"] },
      "note": { "type": "string", "maxLength": 255 },
      "requestedAt": {
        "oneOf": [
          { "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds" },
          { "type": "null" }
        ]
      },
      "expiresAt": {
        "oneOf": [
          { "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds" },
          { "type": "null" }
        ]
      }
    },
    "profileBody": {
      "type": "object",
      "required": ["profileRev", "displayName", "bio", "avatar"],
      "properties": {
        "profileRev": {
          "$ref": "urn:socfp:v1:common#/$defs/safeNonNegativeInteger"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 120 },
        "avatar": {
          "oneOf": [{ "$ref": "#/$defs/profileAvatar" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "memberProfileBody": {
      "type": "object",
      "required": ["profileRev", "displayName", "avatar"],
      "properties": {
        "profileRev": {
          "$ref": "urn:socfp:v1:common#/$defs/safeNonNegativeInteger"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 30 },
        "avatar": {
          "oneOf": [{ "$ref": "#/$defs/profileAvatar" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "relationshipIntentBody": {
      "type": "object",
      "required": ["status", "note", "requestedAt", "expiresAt"],
      "properties": {
        "status": { "enum": ["REQUESTED", "ACCEPTED", "REVOKED"] },
        "note": { "type": "string", "maxLength": 255 },
        "requestedAt": {
          "oneOf": [
            {
              "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds"
            },
            { "type": "null" }
          ]
        },
        "expiresAt": {
          "oneOf": [
            {
              "$ref": "urn:socfp:v1:common#/$defs/epochMilliseconds"
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "REQUESTED" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "requestedAt": { "type": "integer" },
              "expiresAt": { "type": "integer" }
            }
          },
          "else": { "properties": { "expiresAt": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "groupMetaBody": {
      "type": "object",
      "required": [
        "rosterRev",
        "active",
        "dissolved",
        "owner",
        "membersCanInvite",
        "members"
      ],
      "properties": {
        "rosterRev": {
          "$ref": "urn:socfp:v1:common#/$defs/safeNonNegativeInteger"
        },
        "active": { "type": "boolean" },
        "dissolved": { "type": "boolean" },
        "owner": {
          "oneOf": [
            { "$ref": "urn:socfp:v1:common#/$defs/address" },
            { "type": "null" }
          ]
        },
        "membersCanInvite": { "type": "boolean" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["account", "domain", "role"],
            "properties": {
              "account": {
                "$ref": "urn:socfp:v1:common#/$defs/userAccount"
              },
              "domain": {
                "$ref": "urn:socfp:v1:common#/$defs/domain"
              },
              "role": { "enum": ["OWNER", "ADMIN", "MEMBER"] }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "dissolved": { "const": true } },
            "required": ["dissolved"]
          },
          "then": {
            "properties": {
              "active": { "const": false },
              "owner": { "type": "null" },
              "members": { "maxItems": 0 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "itemBase": {
      "type": "object",
      "required": [
        "account",
        "domain",
        "eventType",
        "feedId",
        "body"
      ],
      "properties": {
        "account": { "$ref": "urn:socfp:v1:common#/$defs/account" },
        "domain": { "$ref": "urn:socfp:v1:common#/$defs/domain" },
        "eventType": { "type": "string" },
        "feedId": {
          "$ref": "urn:socfp:v1:common#/$defs/positiveDecimalString"
        },
        "body": { "type": "object" }
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "eventType": { "const": "PROFILE" },
            "body": { "$ref": "#/$defs/profileBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "account": {
              "$ref": "urn:socfp:v1:common#/$defs/userAccount"
            },
            "eventType": { "const": "MEMBER_PROFILE" },
            "body": { "$ref": "#/$defs/memberProfileBody" }
          },
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "account": {
              "$ref": "urn:socfp:v1:common#/$defs/account"
            },
            "eventType": { "const": "RELATIONSHIP_INTENT" },
            "localAccount": {
              "$ref": "urn:socfp:v1:common#/$defs/account"
            },
            "body": { "$ref": "#/$defs/relationshipIntentBody" }
          },
          "not": {
            "properties": {
              "account": {
                "$ref": "urn:socfp:v1:common#/$defs/groupAccount"
              },
              "localAccount": {
                "$ref": "urn:socfp:v1:common#/$defs/groupAccount"
              }
            },
            "required": ["account", "localAccount"]
          },
          "required": ["localAccount"],
          "unevaluatedProperties": false
        },
        {
          "$ref": "#/$defs/itemBase",
          "properties": {
            "account": {
              "$ref": "urn:socfp:v1:common#/$defs/groupAccount"
            },
            "eventType": { "const": "GROUP_META" },
            "body": { "$ref": "#/$defs/groupMetaBody" }
          },
          "unevaluatedProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": ["items", "scannedThrough", "stateFeedEndId", "hasMore"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "scannedThrough": {
      "$ref": "urn:socfp:v1:common#/$defs/decimalString"
    },
    "stateFeedEndId": {
      "$ref": "urn:socfp:v1:common#/$defs/decimalString"
    },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
