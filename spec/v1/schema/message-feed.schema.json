{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somfp:v1:message-feed",
  "title": "GET /s2s/v1/message-feed response data",
  "$defs": {
    "thread": {
      "oneOf": [
        {
          "type": "object",
          "required": ["account"],
          "properties": {
            "account": {
              "$ref": "urn:somfp:v1:common#/$defs/groupAccount"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["account", "localAccount"],
          "properties": {
            "account": {
              "$ref": "urn:somfp:v1:common#/$defs/userAccount"
            },
            "localAccount": {
              "$ref": "urn:somfp:v1:common#/$defs/userAccount"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["feedId", "thread", "messageEndSeq"],
      "properties": {
        "feedId": {
          "$ref": "urn:somfp:v1:common#/$defs/positiveDecimalString"
        },
        "thread": { "$ref": "#/$defs/thread" },
        "messageEndSeq": {
          "$ref": "urn:somfp:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["items", "scannedThrough", "messageFeedEndId", "hasMore"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "scannedThrough": {
      "$ref": "urn:somfp:v1:common#/$defs/decimalString"
    },
    "messageFeedEndId": {
      "$ref": "urn:somfp:v1:common#/$defs/decimalString"
    },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
