# compiled output
/dist
/node_modules

# Logs — global *.log catch-all + npm debug (npm is the only package manager here; no pnpm/yarn/lerna)
*.log
npm-debug.log*

# OS
.DS_Store

# Tests
/coverage

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Firebase client config (google-services.json). Federated app: each operator runs their own Firebase
# project, so this is NEVER bundled in the APK or committed — it lives on the server under data/
# (data/google-services.json, path overridable via FIREBASE_CLIENT_CONFIG) and is read + published at runtime
# so the APK initializes FirebaseApp dynamically. Defense in depth alongside src-tauri/.gitignore +
# gen/android/.gitignore so a stray copy anywhere in the tree (e.g. downloaded to the repo root) can never be
# committed.
google-services.json

# Firebase service-account key (the SEND-side credential backing GOOGLE_APPLICATION_CREDENTIALS). Like
# google-services.json it's a per-deploy Firebase-console download — operator places it under data/
# (gitignored via /data), never committed.
*-firebase-adminsdk-*.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Prisma 7 generated client（由 `prisma generate` 产出，勿提交；新检出经 postinstall 自动生成）
/src/prisma/generated

# temp directory
.temp
.tmp

.npmrc

# Unified runtime state — NEVER tracked. Everything the app writes lives under data/ (=<cwd>/data in
# dev, /app/data under Docker's WORKDIR): S2S Ed25519 + JWT HMAC keys, logs/, uploads/ (avatars + CAS
# shards), Caddy state, postgres/. Bind-mounted out of the container in docker-compose.
/data

# Web bundle build artifact (scripts/package-web-bundle.mjs output). The bundle served in production is
# image-bound — baked read-only at /app/shell-bundle by the Dockerfile, never under /app/data. This entry
# only ignores the LOCAL dev packager output (when `npm run bundle:package` is run on the host).
/shell-bundle

# Docker launch directories — runtime secrets/state when testing in-tree; templates remain tracked.
/deploy/data/

# Federation e2e compiled entry — tsc output of test/federation-app.main.ts + deps, rebuilt on
# demand by ensureCompiledEntry (test/federation-harness.ts); never tracked
/.e2e-build
