{
  "name": "soms-web",
  "version": "0.1.0-alpha.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/start.mjs web serve",
    "start:playground": "node scripts/start.mjs playground serve",
    "build": "node scripts/build.mjs web",
    "build:development": "npm run build -- --configuration development",
    "build:native": "node scripts/build.mjs native",
    "build:playground": "node scripts/build.mjs playground",
    "verify:native": "node scripts/verify-native-build.mjs",
    "watch": "node scripts/start.mjs web watch",
    "test": "ng test",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:build": "node --test scripts/*.test.mjs",
    "icons:generate": "./scripts/gen-icons.sh",
    "gen:api": "npm ci --prefix tools/openapi-generator --workspaces=false && npm exec --prefix tools/openapi-generator -- openapi-typescript http://localhost:3000/api/v1/docs-json -o src/app/services/api-types.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/service-worker": "^22.1.2",
    "@jsverse/transloco": "^8.4.0",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-mention": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "artplayer": "^5.4.0",
    "dayjs": "^1.11.13",
    "idb": "^8.0.3",
    "motion": "^12.42.2",
    "photoswipe": "^5.4.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@tauri-apps/cli": "^2.11.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "undici": "^8.10.0",
    "vitest": "^4.0.8"
  }
}
