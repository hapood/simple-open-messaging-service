{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/logo.svg",
          "/icons/**",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/media/**",
          "/fonts/**"
        ]
      }
    }
  ],
  "dataGroups": [],
  "navigationUrls": [
    "!/api/**",
    "!/uploads/**",
    "!/admin",
    "!/admin/**",
    "!/**/*.*",
    "!/**/**/*.*",
    "/**"
  ]
}
