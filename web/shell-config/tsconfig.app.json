/* shell-config bootstrap: a separate Angular application (its own root/src) that ships BUNDLED as the
   `init` window — the first-run setup wizard AND the reconfigure UI. The main chat SPA is NOT bundled;
   it is downloaded + Ed25519-verified at runtime (src-tauri/src/lib.rs). Mirrors tsconfig.app.json but
   scopes compilation to this project's src so it never pulls the main app. */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/shell-config",
    "types": []
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts"]
}
