# Caddy edge for SOMS — single published port 7667 (HTTPS only), TLS via Cloudflare DNS-01.
# Caddy terminates TLS (+ h2 / h3) at the edge and reverse-proxies to the app over plain HTTP/1.1.
#
# This Caddyfile is baked into the `full` image (Dockerfile `full` stage) and run in-process alongside
# the node app by docker/entrypoint.sh; the same file also serves an external-proxy topology (mount it
# into your own Caddy and set CADDY_UPSTREAM to the app host). {$VAR}s are substituted by Caddy at
# config-load time from the process environment.
#
# The app was designed for exactly this topology (see src/main.ts): with no TLS_CERT/TLS_KEY it
# runs HTTP/1.1 behind a proxy that terminates TLS+h2. trustProxy:1 + secure:'auto' read Caddy's
# X-Forwarded-* headers, so real client IPs (rate limit, logs) and secure media cookies work.
# SSE passes through unbuffered — Caddy auto-flushes text/event-stream and excludes it from encode.
#
# Env (substituted at config load — set on the app service in docker-compose.yml, shared by both
# processes in the all-in-one container):
#   {$SOMS_PUBLIC_HOST}        the hostname clients connect to — Caddy bind + TLS cert name + SRV target.
#                             Equals SOMS_DOMAIN in the common single-domain case; differs ONLY for SRV
#                             delegation (identity @user@<SOMS_DOMAIN> stays while the service is reached
#                             at another host). Set in docker-compose.yml x-config as soms_public_host.
#   {$SOMS_DOMAIN}             the federation IDENTITY — the <domain> in @user@<SOMS_DOMAIN> and the keyId.
#                             NOT consumed by Caddy; the app publishes it in /.well-known/soms.
#   {$CLOUDFLARE_API_TOKEN}    Cloudflare API token with Zone:DNS:Edit on the SOMS_DOMAIN zone
#   {$CADDY_UPSTREAM}          origin address; defaults to 127.0.0.1:3000 (set app:3000 for external proxy)
#
# DNS provider: the `full` image bundles EVERY non-archived DNS-01 provider (see the caddy-build stage
# in Dockerfile), so switching providers is a CONFIG change, not a rebuild. Cloudflare is the baked
# default (zero-edit). To use another provider, edit this file's `tls { dns <provider> ... }` block to
# match that provider's syntax + credential env, then bind-mount it over the baked copy by uncommenting
# the `- ./Caddyfile:/etc/caddy/Caddyfile:ro` volume in docker-compose.yml. Examples (replace the
# cloudflare `tls` block above):
#
#   # AliDNS (Alibaba Cloud) — env: ALICLOUD_ACCESS_KEY, ALICLOUD_SECRET_KEY
#   tls {
#       dns alidns {env.ALICLOUD_ACCESS_KEY} {env.ALICLOUD_SECRET_KEY}
#   }
#   # DNSPod / Tencent Cloud — env: DNSPOD_API_KEY  (id,token)
#   tls {
#       dns dnspod {env.DNSPOD_API_KEY}
#   }
#   # AWS Route 53 — reads AWS_REGION + AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY from env
#   tls {
#       dns route53
#   }
# Credential syntax varies per provider (some take inline args, some read env, some need a block) — see
# https://github.com/caddy-dns/<provider> for each module's exact Caddyfile syntax.
{
	# No port 80 is published, so drop the automatic HTTP->HTTPS redirect listener.
	# Certificate automation (DNS-01) is unaffected — it never needed 80/443.
	auto_https disable_redirects

	# Persist ALL Caddy state (ACME accounts + certs, OCSP staples, autosaved config) under /app/data/caddy
	# — inside the unified /app/data volume (alongside the S2S/JWT keys and app logs), so ONE named volume
	# (app-data:/app/data) keeps everything across restart/recreate/upgrade. ACME certs surviving avoids
	# Let's Encrypt re-issue rate limits. Node-owned, so the unprivileged runtime user writes it fine.
	storage file_system {
		root /app/data/caddy
	}

	# email you@example.com   # optional: uncomment + set for Let's Encrypt expiry notices
}

https://{$SOMS_PUBLIC_HOST}:7667 {
	tls {
		# DNS-01 via Cloudflare — no inbound 80/443 required for issuance or renewal.
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	# Compress responses for the web frontend. SSE (text/event-stream) is auto-excluded.
	encode zstd gzip

	# Origin leg is plain HTTP/1.1 to the app. Caddy sets X-Forwarded-* by default, which the app
	# honors via trustProxy:1 — no header_up needed. CADDY_UPSTREAM defaults to loopback for the
	# all-in-one image (caddy + node in one container); an external proxy sets CADDY_UPSTREAM=app:3000.
	reverse_proxy {$CADDY_UPSTREAM:127.0.0.1:3000}
}
