# Keep build context small and prevent local artifacts/secrets from leaking into images.
# Explicit paths (no **) so the legacy builder matches them reliably.
/node_modules
/web/node_modules
/web/tools/openapi-generator
/admin-web/node_modules
/web/.angular
/web/.vscode
/dist
/web/dist
/admin-web/dist
# Tauri/Android build tree (src-tauri/target ~5GB of Rust artifacts, gen/android) — irrelevant to
# the server image; excluding it keeps the build context tiny. The three version manifests are the
# exception: the server-build stage's version-consistency gate reads them.
/src-tauri/*
!/src-tauri/tauri.conf.json
!/src-tauri/Cargo.toml
!/src-tauri/Cargo.lock
/.git
/.env
/.env.local
/.env.production
/uploads
/data
/deploy/data
/coverage
/test
# Local lab state, agent/tool state, and generated reports — never read by any build stage.
# dev/federation-lab alone carries ~85MB of runtime databases and diagnostic runs.
/dev
/.angular
/.e2e-build
/.tmp
/tmp
/test-results
/docs
/spec
/tools
/deploy
/.github
/.pi
/.claude
# Machine-local build wrappers may contain internal proxy addresses.
/scripts/*.local.sh
/Dockerfile
/.dockerignore
