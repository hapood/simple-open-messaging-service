# Keep build context small and prevent local artifacts/secrets from leaking into images.
# Explicit paths (no **) so the legacy builder matches them reliably.
/node_modules
/web/node_modules
/web/tools/openapi-generator
/admin-web/node_modules
/web/.angular
/web/.vscode
/dist
/web/dist
/admin-web/dist
# Tauri/Android build tree (src-tauri/target ~5GB of Rust artifacts, gen/android) — irrelevant to
# the server image; excluding it keeps the build context tiny.
/src-tauri
/.git
/.env
/.env.local
/.env.production
/uploads
/data
/deploy/data
/coverage
/test
/Dockerfile
/.dockerignore
