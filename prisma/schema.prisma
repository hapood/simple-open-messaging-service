// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                 @id @default(autoincrement())
  account            String              @db.VarChar(31)
  hashPwd            String              @db.VarChar(127)
  name               String // display name (folded from UserExtra.name)
  avatar             String              @default("") // avatar path /uploads/... (folded from UserExtra.avatar)
  bio                String              @default("") @db.VarChar(255) // (folded from UserExtra.bio)
  isForeigner        Boolean
  isGroup            Boolean             @default(false) // true iff a "!"-sigil group identity row (not a person). Mirrors the account grammar; a CHECK keeps them consistent (account LIKE '!%' ⟺ isGroup).
  // "local" for users on THIS server; <peer-domain> for a federated stub. The compound
  // @@unique([account, domain]) below enforces BOTH local and stub uniqueness (a plain account
  // @unique would block a foreign stub sharing a local account). "local" is an internal sentinel —
  // never displayed; the real config.domain is used at runtime.
  domain             String              @default("local") @db.VarChar(63)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isDeleted          Boolean             @default(false)
  hasUrFriendReq     Boolean             @default(false) // unread friend-request badge (folded from userNotiBox). SELF-ONLY in responses — builders must omit it for non-self.
  // Profile revision (name/avatar/bio). On the ORIGIN, bumped on every profile edit (authoritative).
  // On a federated STUB, remoteProfileRev holds the origin's profileRev at last localization — the
  // chat-open probe compares the two and re-pulls when the origin is newer. Null remoteProfileRev =
  // stub not yet localized.
  profileRev         Int                 @default(0)
  remoteProfileRev   Int?
  // Thread-list revision (per-user, monotonic). Bumped on every thread add/delete (friend approve,
  // group join, unfriend, leave, kick). The ThreadRevision log records each (threadId, direction, rev);
  // the client holds this as its cursor and pulls ADD/DELETE deltas via query-thread(from,to].
  threadRevision     Int                 @default(0)
  groupUser          MessageThread?      @relation("GroupUser") // 1:1 back-relation for MessageThread.groupUserId (the GROUP thread whose identity "!"-User is this row; null for humans)
  threadParticipants ThreadParticipant[]
  threadRevisions    ThreadRevision[]
  group              Group?              @relation("GroupIdentity") // 1:1 — present iff this User is a "!"-sigil group identity row (carries owner + roster revision)
  invitesFrom        Invite[]            @relation("InviteFrom") // invites THIS user sent
  invitesTo          Invite[]            @relation("InviteTo") // invites addressed to THIS user
  messages           Message[]           @relation("AuthoredMessages")
  pushTokens         PushToken[]
  sessionTokens      SessionToken[]
  userBlocks         UserBlock[]         @relation("UserBlocks") // users THIS user has blocked
  userBlockedBy      UserBlock[]         @relation("UserBlockedBy") // users who have blocked THIS user
  admins             Admin[] // linked admin profile (absent for normal users; an admin's identity IS this User row — name + password live here, the Admin row holds only admin-specific state)

  @@unique([account, domain])
}

// UserExtra and userNotiBox (former 1:1 profile/badge tables) folded into User as inline columns
// (name/avatar/bio/hasUrFriendReq) — see the fold migration 20260707180000_fold_user_extra_notibox.

/// Delivery platform for a push registration token. Determines the server-side transport
/// (firebase-admin covers ANDROID/IOS today; WEB will use the standard Web Push / VAPID path).
enum PushPlatform {
  ANDROID
  WEB
  IOS
}

/// One row per (device, user) push registration token. The client obtains an FCM registration token
/// (ANDROID) or a Web Push subscription endpoint (WEB) and POSTs it to /devices/register; the server
/// fans out to these tokens on NEW_MESSAGE for any recipient with no live SSE connection
/// (see PushService.dispatchForMessage). `token` is globally unique — ANDROID = FCM registration
/// token, WEB = the push endpoint URL ( widened to 500 for Mozilla/FCM endpoints); a device's token is
/// re-owned to the current user on re-register (upsert on token), so an account switch on the same
/// device re-points delivery without leaving a stale row. WEB rows also carry the subscription's
/// p256dh + auth keys (nullable; ANDROID leaves them null). `lastSeenAt` lets a future stale-token
/// sweep prune devices that haven't re-registered in N days.
model PushToken {
  id         Int          @id @default(autoincrement())
  userId     Int
  user       User         @relation(fields: [userId], references: [id])
  token      String       @unique @db.VarChar(500)
  deviceId   String?      @db.VarChar(127) // links to the web client's localStorage device_id (auth.service)
  platform   PushPlatform
  webP256dh  String?      @db.VarChar(255) // Web Push subscription p256dh key (WEB only)
  webAuth    String?      @db.VarChar(255) // Web Push subscription auth key (WEB only)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  lastSeenAt DateTime     @default(now())

  @@index([userId]) // dispatch lookup: tokens to fan out for a recipient set
}

/// Long-lived session credential that supersedes the access+refresh pair for native +
/// web clients (Telegram-style: one credential per device, revocable). Opaque (`randomBytes(32)`),
/// sha256-hashed in DB — the plaintext is returned once at issue and sent as a Bearer header.
/// `expiresAt` is NULL for the native app (no lifecycle — revocation-only; the token lives in the
/// device's OS secure store) or a sliding 30-day deadline for web (JS-memory storage; extended on use
/// via `lastSeenAt` so active sessions stay alive while idle ones expire). Validated by
/// BearerAuthService, shared by the global JwtAuthGuard and the /uploads/* media preHandler.
model SessionToken {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique @db.VarChar(127) // sha256 hash, never the plaintext
  client       String    @db.VarChar(16) // app | web | desktop — drives the lifetime policy + the device-list icon/label
  device       String?   @db.VarChar(127) // human-friendly device label the client reports at login (e.g. "Pixel 7", "Chrome · macOS")
  userAgent    String?   @db.VarChar(255) // raw UA captured server-side from the HTTP header; parsed into browser/os for the device list
  ip           String?   @db.VarChar(64) // sign-in IP (captured at issue time)
  lastSeenIp   String?   @db.VarChar(64) // most-recent IP (updated on the throttled sliding touch) — the device-list "last seen" location source
  createdAt    DateTime  @default(now())
  expiresAt    DateTime? // null = never (native app); set = sliding deadline (web/desktop)
  lastSeenAt   DateTime  @default(now()) // sliding-window activity tracker (web/desktop)
  persistent   Boolean   @default(true) // web/desktop cookie persistence: true=14d sliding cookie, false=session cookie (keep=false); moot for app (no-expiry). Server-side because the browser sends only the cookie value, not its attributes.
  revokedAt    DateTime? // soft revoke (logout / logout-all / password change / admin disable)
  revokeReason String?   @db.VarChar(32) // logout|device_revoke|all_devices|password_change|admin_disable (observability)

  @@index([userId])
}

// Group-exclusive state. The group's identity (name/avatar/bio) lives on its "!"-sigil User row (shared
// profile shape); this table holds only owner + roster revision (the federation pull cursor). Identity
// revision is on User.profileRev.
model Group {
  id              Int      @id @default(autoincrement())
  groupUserId     Int      @unique // → User.id (!-sigil identity row); 1:1 with the GROUP thread
  ownerId         Int // group owner (denormalized from ThreadParticipant role=OWNER for fast lookup)
  // Origin roster revision — bumped on every member/role change. The federation roster probe compares
  // this against the mirror's remoteRosterRev and re-pulls the roster when newer. Symmetric with
  // User.profileRev.
  rosterRev       Int      @default(0)
  // Mirror's cursor: the origin rosterRev last pulled. Null for the local origin (its own rosterRev is
  // authoritative). Symmetric with User.remoteProfileRev.
  remoteRosterRev Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  groupUser User @relation("GroupIdentity", fields: [groupUserId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

/// Direction of a ThreadRevision log entry: ADD (thread joined the user's list) or DELETE (left/removed).
enum ThreadRevisionDirection {
  ADD
  DELETE
}

/// Per-user thread-list operation log. One row per (user, thread, direction) — at most one ADD and one
/// DELETE per thread (re-add upserts the ADD row: isDelete=false + new revision). `revision` is the
/// User.threadRevision at operation time (monotonic per user). The client pulls deltas via
/// query-thread(from, to] (revision in range) and applies ADD/DELETE locally. `isDelete` on the ADD row
/// is a redundant current-state flag for fast "active threads" queries (WHERE direction=ADD AND
/// isDelete=false) — snapshot(revision=R) still uses the revision columns for historical accuracy.
model ThreadRevision {
  id        BigInt                  @id @default(autoincrement())
  userId    Int
  threadId  Int
  direction ThreadRevisionDirection
  revision  Int
  isDelete  Boolean                 @default(false) // ADD row only: current soft-delete state (fast active-threads query)
  createdAt DateTime                @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId, direction]) // one ADD + one DELETE per (user, thread)
  @@index([userId, revision])
}

enum MessageThreadType {
  P2P
  GROUP
}

/// Group member role (only meaningful when the thread type is GROUP; null for P2P participants).
enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

/// Kind of an Invite row. The Invite table is the single home for both friend-add and group-invite.
enum InviteKind {
  FRIEND
  GROUP
}

/// Lifecycle of an Invite row. PENDING → one of the terminals; rows are NEVER hard-deleted (kept as
/// history; a future GC sweep will flip stale PENDING → EXPIRED, deferred for now).
enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

/// One row per (user, conversation) — the single source of truth for who is in a thread and their per-user
/// state (read position, mute, role for GROUP). P2P and GROUP share this table; role is null for P2P.
/// Replaces the participation half of UserMessageThread and the whole GroupMember table.
model ThreadParticipant {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  threadId    Int
  thread      MessageThread @relation(fields: [threadId], references: [id])
  lastReadSeq Int? // read watermark; unread = count(Message where threadId=T and seq > lastReadSeq)
  role        GroupRole? // OWNER/ADMIN/MEMBER for GROUP; null for P2P (no default — set explicitly on group create/join)
  joinedAt    DateTime      @default(now())
  muted       Boolean       @default(false)
  pinned      Boolean       @default(false)
  pinnedAt    DateTime? // most-recently-pinned-first ordering; null when not pinned
  clearedAt   DateTime? // per-user "clear history" watermark; query-messages hides rows older than this
  alias       String?       @db.VarChar(64) // per-user remark/nickname for this thread (P2P: peer; GROUP: group); null = use real name
  leftAt      DateTime? // soft-leave / hidden; null = active member
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, threadId])
  @@index([threadId]) // roster of a conversation
  @@index([userId]) // "my conversations"
  @@index([userId, pinned]) // pinned-first conversation list per user
}

/// A friend-add or group-invite (uniform shape; the single home for both). FRIEND: threadId null (the
/// P2P thread is minted on accept); GROUP: threadId = target group. Accepted by sending the invite id.
///
/// Duplicates overwrite in place (upsert-on-P2002 via partial unique indexes): FRIEND on (from, to),
/// GROUP on (to, thread) regardless of inviter — a second admin inviting the same friend to the same
/// group refreshes the PENDING row. 7d expiry validated at accept time; rows are never hard-deleted.
/// `origin`/`originId` carry the minting server for cross-server delivery dedup.
model Invite {
  id         BigInt       @id @default(autoincrement())
  kind       InviteKind
  fromUserId Int // inviter (a local user; for an inbound federated invite, the foreign stub)
  toUserId   Int // recipient / decision-maker (a local user on THIS server)
  threadId   Int? // GROUP: target group thread; FRIEND: null (P2P thread created on accept)
  note       String       @default("") @db.VarChar(255) // invite message / reason (≤255)
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime // 7d; validated at accept time (background sweep deferred)
  origin     String       @db.VarChar(63) // minting server domain (our domain for local invites)
  originId   String       @db.VarChar(127) // minting-server id; (origin, originId) = delivery dedup
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  fromUser User           @relation("InviteFrom", fields: [fromUserId], references: [id])
  toUser   User           @relation("InviteTo", fields: [toUserId], references: [id])
  thread   MessageThread? @relation(fields: [threadId], references: [id])

  @@unique([origin, originId]) // local + cross-server delivery dedup (idempotent create)
  @@index([toUserId, status, kind]) // incoming list (friend-pending panel)
  @@index([fromUserId, status, kind]) // outgoing list
  @@index([kind, threadId, toUserId, status]) // GROUP dedup + roster queries
}

/// One-way block, independent of friendship (survives an unfriend; applies to strangers too — hence not
/// a FriendshipStatus, which would conflate lifecycles). Exactly one row per (blocker, blocked) direction;
/// mutual block = two rows. The message path consults this to drop fan-out and filter query-messages.
model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id])
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId]) // "who has blocked me" lookup (message send/query filter)
}

model MessageThread {
  id        Int               @id @default(autoincrement())
  type      MessageThreadType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Last-allocated Message.seq for this thread (-1 = no messages yet). The atomic counter backing seq
  // allocation: `UPDATE curSeq = curSeq + 1 RETURNING curSeq` inside the message-create tx serializes
  // per-thread sends and keeps curSeq == MAX(seq), so it also serves as "latest seq" with no aggregate.
  curSeq Int @default(-1)

  // Federation pull cursor: the REMOTE thread seq this server has pulled up to. Seeded by the invite's
  // `sinceSeq` (-1 = nothing yet), advanced to the response `latestSeq` after each pull. Stored (not
  // derived) because a freshly-joined member has no local rows — derivation would wrongly force a
  // full-pull instead of resuming from `sinceSeq`. Message.originSeq remains the per-author dedup key.
  pullUntil Int @default(-1)

  // Denormalized "last message" cache for the conversation list (hot read path). No FKs — written in
  // the same tx as the Message; the source of truth (Message.seq/creator/createdAt) keeps its FKs.
  // Nullable for empty threads. lastMessageSeq is the cursor, NOT the unread watermark (that's per-
  // participant on ThreadParticipant.lastReadSeq).
  lastMessageSeq      Int?
  lastMessagePreview  String?   @db.VarChar(255)
  lastMessageAt       DateTime?

  // The "!"-sigil User row carrying this GROUP thread's identity (name/avatar/bio). Non-null iff
  // type=GROUP; null for P2P. @unique → one thread per group-User. Cascade-deletes with the group-user.
  // The federated `!account`/origin domain are read via groupUser.account/domain; owner + roster rev
  // via groupUser.group.
  groupUserId       Int?                @unique
  groupUser         User?               @relation("GroupUser", fields: [groupUserId], references: [id], onDelete: Cascade)
  ThreadParticipant ThreadParticipant[]
  invites           Invite[]
  Message           Message[]
  MediaMessage      MediaMessage[] // per-object media authz index (digest → thread)
  PendingMedia      PendingMedia[] // in-flight media sends/localizes not yet committed as a Message
  ThreadRevision    ThreadRevision[] // per-user add/delete log (thread-list versioning)

  @@index([groupUserId])
}

enum ContentType {
  PURE_TEXT
  INVITE
  IMAGE
  VIDEO
  FILE
  AUDIO
}

model Message {
  // INTERNAL surrogate PK, NEVER exposed (omitted from HTTP/SSE/federation, which carry `seq`). A global
  // autoincrement would leak cross-conversation throughput (deltas reveal server-wide volume), so it
  // exists only as storage identity + the MediaMessage FK target.
  id               BigInt        @id @default(autoincrement())
  // Per-thread monotonic seq (0-indexed), allocated atomically from curSeq inside the message-create tx
  // → gapless modulo rollback/delete, no retry loop. The EXTERNAL ordering key + frontend message
  // identity (keyset cursor, read watermark); deltas reveal only THIS thread's volume. Each server
  // assigns its OWN seq; a receiver re-seqs pulled messages into its local space (see originSeq).
  seq              Int
  contentType      ContentType
  content          String
  threadId         Int
  creator          Int
  threadItem       MessageThread @relation(fields: [threadId], references: [id])
  creatorItem      User          @relation("AuthoredMessages", fields: [creator], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  isDeleted        Boolean       @default(false)
  // Client-generated UUID for send idempotency: a retried send with the same value returns the original
  // Message instead of creating a duplicate. Nullable + @unique → a partial unique index (NULLs are
  // distinct), so legacy sends that omit it coexist. See MessageService.writeMsgToThread.
  clientMessageId  String?       @unique @db.VarChar(36)
  // The ORIGINATING server's per-thread seq — the cross-server value. Equals `seq` on the origin; a
  // receiver copies it verbatim while allocating its own local `seq` (same value on both sides). The
  // federation dedup key + per-(thread, sender) pull cursor (receiver pulls originSeq > MAX). Each side
  // keeps its own seq; no cross-server sequence-space consistency is needed. Null = legacy rows only.
  originSeq        Int?
  // The SENDER server's allocation time (copied from the pulled payload's `ts`). NEVER displayed — the
  // chatbox + conversation list use the receiver's `createdAt` (local arrival time). Stored for future
  // use (quota day-bucketing, audit). Null for locally-authored messages (their createdAt IS the origin
  // time) and pre-Step-2 legacy rows.
  originServerTime DateTime?

  mediaMessages MediaMessage[] // per-object media authz index (digest → thread)

  @@unique([threadId, seq]) // per-thread seq identity: allocation authority + keyset cursor (also the hot pagination index)
  @@unique([threadId, creator, originSeq]) // (a) sender seq allocation race AND (b) receiver pull dedup
  @@index([threadId, createdAt])
  @@index([createdAt]) // cross-thread "messages since T" catch-up (POST /notifications/missed) — global time range scan
  @@index([creator])
  @@index([threadId, creator, originSeq]) // federation pull query + MAX(cursor) derivation
}

/// Content-addressed media asset (chat images/files/video/audio). One file per sha256 digest at
/// uploads/shards/<digest[0:2]>/<digest[2:4]>/<digest>.<ext>; `refs` is a denormalized refcount
/// (bumped on upload/dedup, decremented on message-delete; GC reclaims at refs=0). Avatars are NOT
/// tracked here — they keep the uploads/<base>-<size>.webp sharp pipeline. No FK to Message: the URL
/// embeds the digest, so the link is by-value. Internal only — never in API responses. Extension +
/// MIME are not stored (recoverable from the filename / set by @fastify/static at serving time).
model MediaAsset {
  digest    String   @id @db.VarChar(64) // sha256 hex (64 chars); also the on-disk filename stem
  bytes     BigInt // file size (BigInt: video cap 100MB; Int would overflow beyond ~2GB). Audit/monitoring only.
  refs      Int      @default(0) // reference count; GC reclaims file + row at 0
  createdAt DateTime @default(now())

  @@index([refs]) // GC sweep: WHERE refs <= 0
}

// Per-object media authorization index. The /uploads/shards/* gate answers "may this user read this
// digest?" with one indexed EXISTS over this table joined to ThreadParticipant. 1:1 with a media-bearing
// Message (one image/file/video/audio per message; albums are a FRONTEND grouping of consecutive
// single-image messages) → messageId is the sole @id. Written at send time; threadId is denormalized so
// the gate skips a JOIN to Message. Never returned in API responses.
model MediaMessage {
  messageId BigInt   @id // == Message.id; the row's sole identity (1:1 with a media-bearing message)
  threadId  Int // denormalized from Message (the /uploads gate skips a JOIN to Message)
  digest    String   @db.VarChar(64) // sha256 hex; the CAS url stem — matches MediaAsset.digest
  createdAt DateTime @default(now())

  message Message       @relation(fields: [messageId], references: [id])
  thread  MessageThread @relation(fields: [threadId], references: [id])

  @@index([digest]) // hot gate path: WHERE digest = $D (the @id index covers messageId lookups)
  @@index([threadId])
}

/// In-flight media staging. A media message is NOT committed as a Message until its bytes are confirmed
/// (uploaded locally / localized federated); until then only this row exists — no Message, no seq, nothing
/// visible. On success it's deleted as the real Message+MediaMessage are created atomically (promote); on
/// failure it's marked `failed` (no auto-retry). Created BEFORE the file write so a crash always leaves an
/// attributable record for the GC (stale pending row + its file/asset), never an unattributed orphan.
///
/// LOCAL: clientMessageId is the optimistic-send idempotency key; `content` holds client-probed display
/// metadata only (the CAS url is injected at promote → never client-supplied). FEDERATED: originSeq
/// (+originDomain/originServerTime) is the pull dedup key (mirrors Message's unique); `content` is the
/// pulled payload verbatim.
model PendingMedia {
  id               BigInt      @id @default(autoincrement())
  threadId         Int
  creatorId        Int // local sender userId; federated = foreign stub userId
  contentType      ContentType
  // LOCAL: client-probed display metadata JSON ({w,h} / {w,h,duration} / {duration} / {}); the url is
  // injected at promote. FEDERATED: the pulled content verbatim (peer's server-relative shard URL +
  // metadata) — after localization the same content-addressed path serves same-origin.
  content          String
  digest           String?     @db.VarChar(64) // set once bytes land → links staging to MediaAsset/file
  clientMessageId  String?     @unique @db.VarChar(36) // LOCAL idempotency (optimistic-send key)
  originSeq        Int? // FEDERATED provenance + pull dedup (NULL for local)
  originDomain     String?     @db.VarChar(63)
  originServerTime DateTime?
  status           String      @default("pending") @db.VarChar(12) // pending | failed
  failReason       String?     @db.VarChar(255)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  thread MessageThread @relation(fields: [threadId], references: [id])

  @@unique([threadId, creatorId, originSeq]) // federated dedup (NULL originSeq = local → many allowed)
  @@index([threadId])
  @@index([status, createdAt]) // GC stale-pending sweep
}

/// Admin RBAC tiers. SUPER_ADMIN = all powers (default; the seed admin keeps full access); ADMIN =
/// everyday operations; VIEWER = read-only (passes AdminAuthGuard on list/view endpoints, but every
/// mutating endpoint is gated to SUPER_ADMIN / ADMIN).
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

/// Admin profile, LINKED to a User (single account namespace — no user/admin name collision possible).
/// Identity (account name + password) lives on the linked User; this row holds only admin-specific state
/// (role, enabled flag, tokenVersion for global session revocation, last login, admin refresh-tokens).
/// Admin login authenticates the linked User's password, then issues an admin session. Admin auth stays
/// physically isolated from user auth (separate AdminRefreshToken + adminSecret + scope:'admin').
model Admin {
  id            Int                 @id @default(autoincrement())
  userId        Int                 @unique
  user          User                @relation(fields: [userId], references: [id])
  role          AdminRole           @default(SUPER_ADMIN)
  enabled       Boolean             @default(true)
  tokenVersion  Int                 @default(0) // bumping this invalidates ALL of the admin's access tokens (disable / role change)
  lastLoginIp   String?             @db.VarChar(64)
  lastLoginAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  refreshTokens AdminRefreshToken[]
  actionLogs    AdminActionLog[]
}

/// Admin refresh token (family-based + reuse detection, mirrors RefreshToken; a separate instance avoids mixing with user sessions).
model AdminRefreshToken {
  id           BigInt    @id @default(autoincrement())
  adminId      Int
  admin        Admin     @relation(fields: [adminId], references: [id])
  tokenHash    String    @unique
  jti          String    @unique
  familyId     String
  userAgent    String?   @db.VarChar(255)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(32)

  @@index([adminId])
  @@index([familyId])
}

/// Append-only audit trail of admin destructive actions (who did what, from where, when, and whether it
/// succeeded). Written best-effort by AdminAuditInterceptor on handlers tagged @Audit — a log failure
/// never blocks the operation. adminRole is denormalized so history survives a later role change.
model AdminActionLog {
  id           BigInt    @id @default(autoincrement())
  adminId      Int
  admin        Admin     @relation(fields: [adminId], references: [id])
  adminRole    AdminRole
  action       String    @db.VarChar(64) // e.g. "user.disable"
  targetType   String?   @db.VarChar(32) // "user" | "peer" | "admin" …
  targetId     String?   @db.VarChar(64)
  ip           String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(255)
  route        String?   @db.VarChar(255)
  success      Boolean   @default(true)
  errorMessage String?   @db.VarChar(255)
  meta         Json?
  at           DateTime  @default(now())

  @@index([adminId])
  @@index([at])
  @@index([action])
}

// ─────────────────────────────────────────────────────────────────────────────
// Federation (S2S). Added 2026-07-07.
// Trust model: FederatedPeer is a DOMAIN ALLOW-LIST only (no key pinning); signing
// keys are fetched from each peer's /.well-known/soms over HTTPS and cached (S2SKeyCache).
// ─────────────────────────────────────────────────────────────────────────────

/// A peer server we may federate with — the CURRENT-STATE row of the trust lifecycle (append-only history
/// is in FederatedPeerEvent). PURE DOMAIN ALLOW-LIST: trust data only — NOT keys or inbox URL (those are
/// fetched from <domain>/.well-known/soms and cached by DiscoveryService).
///
/// trustLevel: pending → trusted (mutual trust via init) → demoted (a signed op failed: cert/key change,
/// server reset, unreachable — re-handshakes on next contact, self-healing). blocked = admin intent that
/// forbids federation (ensurePeerTrusted refuses to re-handshake; the inbound guard rejects it).
model FederatedPeer {
  domain        String    @id @db.VarChar(63) // e.g. other.com
  trustLevel    String    @default("pending") @db.VarChar(15) // pending | trusted | demoted | blocked
  addedBy       String?   @db.VarChar(31) // admin account name who set the state, or null = auto-accepted via init
  createdAt     DateTime  @default(now()) // first discovered
  trustedAt     DateTime? // start of the current trust epoch (init ok); reset on re-trust after a demote
  lastSuccessAt DateTime? // last successful signed S2S op (liveness signal); advanced on every GET/POST ok
  demotedAt     DateTime? // last trusted→demoted transition (a failure while trusted/pending)
  demoteReason  String?   @db.VarChar(255) // latest failure message (refreshed on each failure; cleared on re-trust)
  demotionCount Int       @default(0) // how many times demoted — a flakiness signal
  blockedAt     DateTime? // admin block time

  // Per-peer daily-quota overrides (null = use the global default). Set from the admin Quotas page.
  dailyMsgLimit       Int? // messages/day this peer may pull from us
  dailyImageLimit     Int? // image media items/day
  dailyLargeFileLimit Int? // video/large-file media items/day
  dailyRequestLimit   Int? // inbound friend ops/day (anti-spam)
  maxImageBytes       Int? // single-image byte cap
  maxLargeFileBytes   Int? // single-large-file byte cap

  @@index([trustLevel])
  @@index([lastSuccessAt]) // "stale / never-heard-from" peers sweep
}

/// Append-only trust-lifecycle log — one row per state transition (discovered/trusted/demoted/blocked/
/// unblocked), the source of the admin timeline. Decoupled from FederatedPeer (NO FK; `domain` is a plain
/// string) so history survives any peer-row change and can't cascade-delete. Low volume: only transitions
/// are logged, not every signed op (per-op liveness is the cheap lastSuccessAt UPDATE on FederatedPeer).
model FederatedPeerEvent {
  id        BigInt   @id @default(autoincrement())
  domain    String   @db.VarChar(63)
  type      String   @db.VarChar(15) // discovered | trusted | demoted | blocked | unblocked
  reason    String?  @db.VarChar(255) // demoted: the failure message; blocked: optional admin note
  createdAt DateTime @default(now())

  @@index([domain, createdAt])
  @@index([createdAt])
}

/// Cached peer signing keys. Fetched from <domain>/.well-known/soms (HTTPS), TTL'd by fetchedAt.
/// Multiple rows per domain during key rotation (overlapping keyIds). JWKS-style key set.
model S2SKeyCache {
  domain    String   @db.VarChar(63)
  keyId     String   @db.VarChar(127) // e.g. "other.com/key-1"
  publicKey String   @db.VarChar(127) // ed25519 public key, raw bytes base64
  fetchedAt DateTime @default(now())

  @@id([domain, keyId])
  @@index([domain])
}

/// Inbound friend-op dedup. At-least-once delivery requires idempotent dedup by (origin, opId).
model S2SFriendOpSeen {
  origin     String   @db.VarChar(63)
  opId       String   @db.VarChar(127)
  receivedAt DateTime @default(now())

  @@id([origin, opId])
}

/// Unified daily-quota counters — one row per (node, UTC day, category). A node is a domain: the local
/// SOMS_DOMAIN (one aggregate bucket shared by all local users) or a federated peer domain. `date` is a
/// UTC calendar day, so the budget resets at 00:00 UTC with no cron. QuotaService.tick increments via
/// INSERT … ON CONFLICT DO UPDATE … RETURNING count (exact, not ±1).
model QuotaDailyUsage {
  domain   String   @db.VarChar(63) // SOMS_DOMAIN (local node) OR a peer domain
  date     DateTime @db.Date // UTC calendar day
  category String   @db.VarChar(15) // messages | images | largeFiles | requests
  count    Int      @default(0)

  @@id([domain, date, category])
  @@index([date]) // cheap purge sweep (DELETE WHERE date < today - N)
}

/// Generic key→value store for admin-managed runtime settings. The typed SettingsService
/// (src/settings/settings.service.ts) is the facade over this raw table. Holds operator-configured
/// values that are optional, runtime-toggleable, and UI-managed — e.g. the Web Push VAPID keypair
/// (key='vapid', value=JSON {publicKey, privateKey, subject}). NOT for bootstrap/identity config
/// (DATABASE_URL, SOMS_DOMAIN) — those stay in env, read before the app/DB are up.
model SystemSetting {
  key       String   @id @db.VarChar(63)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
