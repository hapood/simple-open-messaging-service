// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                 @id @default(autoincrement())
  uniqName          String              @unique @db.VarChar(31)
  hashPwd           String              @db.VarChar(127)
  isForeigner       Boolean
  domain            String?             @db.VarChar(63)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  isDeleted         Boolean             @default(false)
  tokenVersion      Int                 @default(0) // bump 即令该用户所有 access token 失效（全设备登出/改密/强制下线）
  userExtraId       Int                 @unique
  userExtra         UserExtra           @relation(fields: [userExtraId], references: [id])
  userNotiBoxId     Int                 @unique
  userNotiBox       userNotiBox         @relation(fields: [userNotiBoxId], references: [id])
  Group             Group[]
  GroupMember       GroupMember[]
  UserMessageThread UserMessageThread[]
  refreshTokens     RefreshToken[]

  @@unique([uniqName, domain])
}

model UserExtra {
  id        Int      @id @default(autoincrement())
  name      String
  avatar    String
  bio       String   @default("") @db.VarChar(255)
  User      User?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model userNotiBox {
  id             Int      @id @default(autoincrement())
  hasUrFriendReq Boolean  @default(false)
  User           User?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Group {
  id          Int           @id @default(autoincrement())
  name        String
  ownerId     Int
  owner       User          @relation(fields: [ownerId], references: [id])
  avatar      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  threadId    Int
  threadItem  MessageThread @relation(fields: [threadId], references: [id])
  GroupMember GroupMember[]
}

model GroupMember {
  id       Int   @id @default(autoincrement())
  groupId  Int
  group    Group @relation(fields: [groupId], references: [id])
  userId   Int
  userItem User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

enum MessageThreadType {
  P2P
  GROUP
}

enum UserMessageThreadStatus {
  FROM_PENDING
  TO_PENDING
  APPROVED
  BLOCKED
  DELETED
}

model UserMessageThread {
  id         Int                     @id @default(autoincrement())
  userId     Int
  userItem   User                   @relation(fields: [userId], references: [id])
  status     UserMessageThreadStatus
  toObjType  MessageThreadType
  toObjId    Int
  reqMessage String
  threadId   Int?
  threadItem MessageThread?          @relation(fields: [threadId], references: [id])
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  isDeleted  Boolean                 @default(false)
  lastRead   BigInt?

  @@unique([userId, toObjType, toObjId])
  @@unique([userId, threadId])
}

model MessageThread {
  id                Int                 @id @default(autoincrement())
  type              MessageThreadType
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  isDeleted         Boolean             @default(false)
  UserMessageThread UserMessageThread[]
  Message           Message[]
  Group             Group[]
}

enum ContentType {
  PURE_TEXT
  INVITE
  IMAGE
  VIDEO
  FILE
  AUDIO
}

model Message {
  id          BigInt        @id @default(autoincrement())
  contentType ContentType
  content     String
  threadId    Int
  creator     Int
  threadItem  MessageThread @relation(fields: [threadId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isDeleted   Boolean       @default(false)
}

enum NotifyType {
  FRIEND_REQUEST
}

model Notify {
  id        BigInt     @id @default(autoincrement())
  userId    Int
  type      NotifyType
  content   Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// refresh_token 落库（替换原内存字典）：支持重启存活、多端、可吊销
model RefreshToken {
  id         BigInt   @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique // 存 sha256 哈希，不存明文
  jti        String   @unique // 该 token 的 JWT id；精确吊销键，与 claim 对齐
  familyId   String // 登录时铸造、轮换时继承；重用检测锚点（重放已吊销 token→全家族失效）
  device     String? // 多端标识（前端 localStorage uuid）
  userAgent  String? @db.VarChar(255) // 签发/轮换时的 UA，会话列表展示用
  ip         String? @db.VarChar(64) // 签发/轮换时的 IP，会话列表展示用
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime? // 软吊销
  revokeReason String? @db.VarChar(32) // 吊销原因：logout|rotated|reuse|all_devices|password_change（仅观测/取证）

  @@index([userId])
  @@index([familyId])
}

/// 管理员账户（独立于聊天 User：拖库隔离 + 消除提权路径 + 可施加更严安全策略）
model Admin {
  id          Int       @id @default(autoincrement())
  username    String    @unique @db.VarChar(31)
  hashPwd     String    @db.VarChar(127)
  enabled     Boolean   @default(true)
  lastLoginIp String?   @db.VarChar(64)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  refreshTokens AdminRefreshToken[]

  @@index([username])
}

/// admin refresh token（家族化 + 重用检测，镜像 RefreshToken，独立实例避免与用户会话混用）
model AdminRefreshToken {
  id         BigInt   @id @default(autoincrement())
  adminId    Int
  admin      Admin    @relation(fields: [adminId], references: [id])
  tokenHash  String   @unique
  jti        String   @unique
  familyId   String
  userAgent  String?  @db.VarChar(255)
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokeReason String? @db.VarChar(32)

  @@index([adminId])
  @@index([familyId])
}
