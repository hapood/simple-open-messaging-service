// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                 @id @default(autoincrement())
  account            String              @db.VarChar(31)
  hashPwd            String              @db.VarChar(127)
  name               String // display name (folded from UserExtra.name)
  avatar             String              @default("") // avatar path /uploads/... (folded from UserExtra.avatar)
  bio                String              @default("") @db.VarChar(255) // (folded from UserExtra.bio)
  isForeigner        Boolean
  isGroup            Boolean             @default(false) // true iff a "!"-sigil group identity row (not a person); grammar-enforced sigil, kept consistent with a CHECK constraint (account LIKE '!%') = isGroup. See docs/account-naming.md.
  // Domain: "local" for users homed on THIS server, <peer-domain> for federated stubs. Non-null +
  // the @@unique([account, domain]) below enforce both local-user and stub uniqueness (a standalone
  // account @unique would block a foreign stub sharing an account with a local user). The federated
  // address/display use the real config.domain at runtime; "local" is an internal sentinel only
  // (MessageThread itself carries no federation columns in Step 1 — each server owns its own thread).
  domain             String              @default("local") @db.VarChar(63)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isDeleted          Boolean             @default(false)
  tokenVersion       Int                 @default(0) // bumping this invalidates ALL of the user's access tokens (all-device logout / password change / force-kick)
  hasUrFriendReq     Boolean             @default(false) // unread friend-request badge (folded from userNotiBox). SELF-ONLY in responses — builders must omit it for non-self.
  // Profile revision (name/avatar/bio changes). On the ORIGIN this is the authoritative counter bumped
  // on every profile edit (updateProfile / updateAvatar / updateGroup); on a federated STUB it is the
  // mirror's cursor (remoteProfileRev) capturing the origin's profileRev at last localization. The
  // chat-open staleness probe (GET /api/v1/s2s/users/:account/revision) compares the origin's current
  // profileRev against remoteProfileRev; a newer origin value triggers a re-pull + re-localize.
  // Null remoteProfileRev = stub not yet localized. See docs/federation-protocol.md (avatar federation).
  profileRev         Int                 @default(0)
  remoteProfileRev   Int?
  // Thread-list revision (per-user, monotonic). Bumped on every thread add/delete (friend approve,
  // group join, unfriend, leave, kick). The ThreadRevision log records each (threadId, direction, rev);
  // the client holds this as its cursor and pulls ADD/DELETE deltas via query-thread(from,to].
  threadRevision     Int                 @default(0)
  groupUser          MessageThread?      @relation("GroupUser") // 1:1 back-relation for MessageThread.groupUserId (the GROUP thread whose identity "!"-User is this row; null for humans)
  threadParticipants ThreadParticipant[]
  threadRevisions    ThreadRevision[]
  group              Group?              @relation("GroupIdentity") // 1:1 — present iff this User is a "!"-sigil group identity row (carries owner + roster revision)
  invitesFrom        Invite[]            @relation("InviteFrom") // invites THIS user sent
  invitesTo          Invite[]            @relation("InviteTo") // invites addressed to THIS user
  messages           Message[]           @relation("AuthoredMessages")
  refreshTokens      RefreshToken[]
  pushTokens         PushToken[]
  notificationTokens NotificationToken[]
  userBlocks         UserBlock[]         @relation("UserBlocks") // users THIS user has blocked
  userBlockedBy      UserBlock[]         @relation("UserBlockedBy") // users who have blocked THIS user
  admins             Admin[] // linked admin profile (absent for normal users; an admin's identity IS this User row — name + password live here, the Admin row holds only admin-specific state)

  @@unique([account, domain])
}

// UserExtra and userNotiBox (former 1:1 profile/badge tables) folded into User as inline columns
// (name/avatar/bio/hasUrFriendReq) — see the fold migration 20260707180000_fold_user_extra_notibox.

/// Delivery platform for a push registration token. Determines the server-side transport
/// (firebase-admin covers ANDROID/IOS today; WEB will use the standard Web Push / VAPID path).
enum PushPlatform {
  ANDROID
  WEB
  IOS
}

/// One row per (device, user) push registration token. The client obtains an FCM registration token
/// (ANDROID) or a Web Push subscription endpoint (WEB) and POSTs it to /devices/register; the server
/// fans out to these tokens on NEW_MESSAGE for any recipient with no live SSE connection
/// (see PushService.dispatchForMessage). `token` is globally unique — ANDROID = FCM registration
/// token, WEB = the push endpoint URL ( widened to 500 for Mozilla/FCM endpoints); a device's token is
/// re-owned to the current user on re-register (upsert on token), so an account switch on the same
/// device re-points delivery without leaving a stale row. WEB rows also carry the subscription's
/// p256dh + auth keys (nullable; ANDROID leaves them null). `lastSeenAt` lets a future stale-token
/// sweep prune devices that haven't re-registered in N days.
model PushToken {
  id         Int          @id @default(autoincrement())
  userId     Int
  user       User         @relation(fields: [userId], references: [id])
  token      String       @unique @db.VarChar(500)
  deviceId   String?      @db.VarChar(127) // links to the web client's localStorage device_id (auth.service)
  platform   PushPlatform
  webP256dh  String?      @db.VarChar(255) // Web Push subscription p256dh key (WEB only)
  webAuth    String?      @db.VarChar(255) // Web Push subscription auth key (WEB only)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  lastSeenAt DateTime     @default(now())

  @@index([userId]) // dispatch lookup: tokens to fan out for a recipient set
}

/// Long-lived, revocable, single-purpose credential for background pollers (the Android WorkManager
/// NotificationSyncWorker) that can't hold a 15-minute access token and must not share the refresh
/// token family (which would race the web client's own renewal). Mirrors RefreshToken's hash+lookup:
/// we store only the sha256 hash; the plaintext is returned once at issue and sent as a Bearer header
/// on /notifications/*. Scoped by NotificationTokenGuard to ONLY the missed-thread endpoint, so a
/// leak grants no other app access. Revoked on logout.
model NotificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @db.VarChar(127) // sha256 hash, never the plaintext
  createdAt DateTime  @default(now())
  expiresAt DateTime // 30-day TTL — the poller re-issues on next foreground login
  revokedAt DateTime? // soft revoke on logout

  @@index([userId])
}

// Group-exclusive state (re-introduced 2026-07): the group's IDENTITY (name/avatar/bio) stays on the
// "!"-sigil User row (isGroup=true) since it shares the profile shape with human users; this table holds
// only group-exclusive fields the User row must not carry — owner + roster revision (the federation pull
// cursor). profile revision lives on User.profileRev / User.remoteProfileRev (identity is shared).
// See docs/account-naming.md, docs/federation-protocol.md.
model Group {
  id              Int      @id @default(autoincrement())
  groupUserId     Int      @unique // → User.id (!-sigil identity row); 1:1 with the GROUP thread
  ownerId         Int // group owner (denormalized from ThreadParticipant role=OWNER for fast lookup)
  // Origin roster revision — bumped on every member/role change (join/leave/kick/role/transfer). The
  // federation roster probe (GET /api/v1/s2s/group/:account/roster-revision) compares this against the
  // mirror's remoteRosterRev to decide whether to re-pull the roster. Symmetric with User.profileRev.
  rosterRev       Int      @default(0)
  // Mirror's remote roster revision cursor (the origin's rosterRev last pulled). Null for local origin
  // groups (their own rosterRev is authoritative). Symmetric with User.remoteProfileRev.
  remoteRosterRev Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  groupUser User @relation("GroupIdentity", fields: [groupUserId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

/// Direction of a ThreadRevision log entry: ADD (thread joined the user's list) or DELETE (left/removed).
enum ThreadRevisionDirection {
  ADD
  DELETE
}

/// Per-user thread-list operation log. One row per (user, thread, direction) — at most one ADD and one
/// DELETE per thread (re-add upserts the ADD row: isDelete=false + new revision). `revision` is the
/// User.threadRevision at operation time (monotonic per user). The client pulls deltas via
/// query-thread(from, to] (revision in range) and applies ADD/DELETE locally. `isDelete` on the ADD row
/// is a redundant current-state flag for fast "active threads" queries (WHERE direction=ADD AND
/// isDelete=false) — snapshot(revision=R) still uses the revision columns for historical accuracy.
model ThreadRevision {
  id        BigInt                @id @default(autoincrement())
  userId    Int
  threadId  Int
  direction ThreadRevisionDirection
  revision  Int
  isDelete  Boolean               @default(false) // ADD row only: current soft-delete state (fast active-threads query)
  createdAt DateTime              @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId, direction]) // one ADD + one DELETE per (user, thread)
  @@index([userId, revision])
}

enum MessageThreadType {
  P2P
  GROUP
}

/// Group member role (only meaningful when the thread type is GROUP; null for P2P participants).
enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

/// Kind of an Invite row. The Invite table is the single home for both friend-add and group-invite.
enum InviteKind {
  FRIEND
  GROUP
}

/// Lifecycle of an Invite row. PENDING → one of the terminals; rows are NEVER hard-deleted (kept as
/// history; a future GC sweep will flip stale PENDING → EXPIRED, deferred for now).
enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

/// One row per (user, conversation) — the single source of truth for who is in a thread and their per-user
/// state (read position, mute, role for GROUP). P2P and GROUP share this table; role is null for P2P.
/// Replaces the participation half of UserMessageThread and the whole GroupMember table.
model ThreadParticipant {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  threadId    Int
  thread      MessageThread @relation(fields: [threadId], references: [id])
  lastReadSeq Int? // read watermark; unread = count(Message where threadId=T and seq > lastReadSeq)
  role        GroupRole? // OWNER/ADMIN/MEMBER for GROUP; null for P2P (no default — set explicitly on group create/join)
  joinedAt    DateTime      @default(now())
  muted       Boolean       @default(false)
  pinned      Boolean       @default(false)
  pinnedAt    DateTime? // most-recently-pinned-first ordering; null when not pinned
  clearedAt   DateTime? // per-user "clear history" watermark; query-messages hides rows older than this
  alias       String?       @db.VarChar(64) // per-user remark/nickname for this thread (P2P: peer; GROUP: group); null = use real name
  leftAt      DateTime? // soft-leave / hidden; null = active member
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, threadId])
  @@index([threadId]) // roster of a conversation
  @@index([userId]) // "my conversations"
  @@index([userId, pinned]) // pinned-first conversation list per user
}

/// A friend-add or group-invite request — the single home for invites of all kinds ("方法一致").
/// kind=FRIEND: one user asking another to be friends (threadId null; the P2P thread is minted on
/// accept). kind=GROUP: a member inviting a friend into a group thread (threadId = target group).
/// Delivered to `toUserId` and accepted by sending the invite id back as a payload.
///
/// Duplicate = new overwrites old (upsert-on-P2002, keyed by the migration's partial unique indexes):
/// FRIEND dedupes on (from, to); GROUP dedupes on (to, thread) regardless of inviter — so a second
/// admin inviting the same friend to the same group refreshes the existing PENDING row in place.
/// Expiry (7d) is validated at accept time; rows are never hard-deleted. `origin`/`originId` carry the
/// minting server for cross-server delivery dedup (local invites use our domain + a ULID).
model Invite {
  id         BigInt       @id @default(autoincrement())
  kind       InviteKind
  fromUserId Int // inviter (a local user; for an inbound federated invite, the foreign stub)
  toUserId   Int // recipient / decision-maker (a local user on THIS server)
  threadId   Int? // GROUP: target group thread; FRIEND: null (P2P thread created on accept)
  note       String       @default("") @db.VarChar(255) // invite message / reason (≤255)
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime // 7d; validated at accept time (background sweep deferred)
  origin     String       @db.VarChar(63) // minting server domain (our domain for local invites)
  originId   String       @db.VarChar(127) // minting-server id; (origin, originId) = delivery dedup
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  fromUser User           @relation("InviteFrom", fields: [fromUserId], references: [id])
  toUser   User           @relation("InviteTo", fields: [toUserId], references: [id])
  thread   MessageThread? @relation(fields: [threadId], references: [id])

  @@unique([origin, originId]) // local + cross-server delivery dedup (idempotent create)
  @@index([toUserId, status, kind]) // incoming list (friend-pending panel)
  @@index([fromUserId, status, kind]) // outgoing list
  @@index([kind, threadId, toUserId, status]) // GROUP dedup + roster queries
}

/// One-way block independent of the Friendship state machine. Blocking survives an unfriend (and applies
/// to strangers), so it is NOT modeled as a FriendshipStatus — that would conflate with the friend
/// lifecycle and reveal/lose state on befriend again. Exactly one row per (blocker, blocked) direction;
/// mutual block = two rows. The message path consults this to drop fan-out and filter query-messages.
model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id])
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId]) // "who has blocked me" lookup (message send/query filter)
}

model MessageThread {
  id        Int               @id @default(autoincrement())
  type      MessageThreadType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  isDeleted Boolean           @default(false)

  // Per-thread last-allocated Message.seq (-1 = no messages yet; first message → 0). The atomic counter
  // backing seq allocation: `UPDATE SET curSeq = curSeq + 1 RETURNING curSeq` inside the message-create
  // tx serializes per-thread sends (a brief wait, never an error) and keeps curSeq == MAX(seq) by
  // construction, so it doubles as the authoritative "latest seq" without a separate aggregate.
  curSeq Int @default(-1)

  // Federation pull cursor: the REMOTE server's thread seq this server has pulled up to. Seeded by the
  // `sinceSeq` carried in the invite/invite-accept at friend-approve / group-accept (-1 = nothing yet,
  // = the head), and advanced to the response `latestSeq` after each successful pull. Used by BOTH 1:1
  // (the peer's thread seq pulled) and a GROUP mirror (the origin's thread seq pulled) — the unified
  // "how far have I caught up" cursor. Stored (not derived from rows) because a freshly-joined member has
  // no local rows yet — derivation would give -1 (full-pull) instead of the seeded `sinceSeq` start.
  // `originSeq` (per-author, on Message) remains the dedup key + the origin's per-author hub-leg cursor.
  pullUntil Int @default(-1)

  // Denormalized "last message" read-cache for the conversation list (the hottest read path).
  // NO foreign keys: these are derived from Message at write time (writeMsgToThread updates them in
  // the same tx as the Message insert); the source of truth — Message.seq / creator / createdAt — keeps
  // its FKs. Nullable: empty threads (no messages yet) stay NULL. lastMessageSeq is the Int cursor
  // (not the unread watermark, which is per-participant on ThreadParticipant.lastReadSeq).
  lastMessageSeq      Int?
  lastMessagePreview  String?   @db.VarChar(255)
  lastMessageSenderId Int?
  lastMessageAt       DateTime?

  // The "!"-sigil User row that CARRIES this GROUP conversation's identity (name/avatar/bio). Non-null
  // iff type=GROUP; null for P2P. @unique enforces ONE thread per group-User (replaces the former
  // fedGroupAccount @unique — the federated group's `!account` is now read via groupUser.account, and
  // the origin domain via groupUser.domain). onDelete: Cascade (deleting the group-user deletes the
  // thread). The Group row (owner + roster revision) is reached via groupUser.group. See docs/account-naming.md.
  groupUserId       Int?                @unique
  groupUser         User?               @relation("GroupUser", fields: [groupUserId], references: [id], onDelete: Cascade)
  ThreadParticipant ThreadParticipant[]
  invites           Invite[]
  Message           Message[]
  MediaMessage      MediaMessage[] // per-object media authz index (digest → thread)
  PendingMedia      PendingMedia[] // in-flight media sends/localizes not yet committed as a Message
  ThreadRevision    ThreadRevision[] // per-user add/delete log (thread-list versioning)

  @@index([groupUserId])
}

enum ContentType {
  PURE_TEXT
  INVITE
  IMAGE
  VIDEO
  FILE
  AUDIO
}

model Message {
  // INTERNAL global surrogate PK. NEVER exposed to clients or federation: a global autoincrement is a
  // cross-conversation throughput side-channel (deltas between two messages in thread T reveal server-wide
  // volume, including threads the observer is not in). It exists only as the storage identity + the
  // MediaMessage FK target. All external surfaces (HTTP/SSE/federation) carry `seq`, never `id` — the
  // response layer omits it (see MessageService.queryMessages / writeMsgToThread return shaping).
  id               BigInt        @id @default(autoincrement())
  // Per-thread monotonic sequence (0-INDEXED: first message in a thread is seq 0). Allocated atomically
  // from MessageThread.curSeq (UPDATE curSeq = curSeq + 1 RETURNING) inside the message-create tx, so it
  // is gapless modulo rollback/delete and needs no retry loop. This is the EXTERNAL ordering key + the
  // frontend's message identity (keyset cursor, read watermark) — its deltas reveal only THIS thread's
  // volume. Each server assigns its OWN per-thread seq; a receiver re-seqs every pulled message into its
  // local space (see originSeq for the cross-server value). See docs/federation-s2s-api.md.
  seq              Int
  contentType      ContentType
  content          String
  threadId         Int
  creator          Int
  threadItem       MessageThread @relation(fields: [threadId], references: [id])
  creatorItem      User          @relation("AuthoredMessages", fields: [creator], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  isDeleted        Boolean       @default(false)
  // Client-generated UUID for send idempotency: a retried send with the same value returns the original
  // Message instead of creating a duplicate. Nullable + @unique → a partial unique index (NULLs are
  // distinct), so legacy sends that omit it coexist. See MessageService.writeMsgToThread.
  clientMessageId  String?       @unique @db.VarChar(36)
  // The ORIGINATING server's per-thread seq for this message — the cross-server federation value. On the
  // origin (a locally-authored message) it equals `seq`; a RECEIVER copies it verbatim from the pulled
  // payload (so the SAME value lives on both sides) while allocating its own local `seq`. This is the
  // federation dedup key + per-(thread, sender) pull cursor: the receiver tracks MAX(originSeq) per
  // (thread, creator) and pulls originSeq > cursor — no cross-server sequence-space consistency is
  // required (each side keeps its own seq; the peer's is stored here). Nullable: legacy rows only;
  // every post-migration row is populated (== seq locally, copied remotely).
  originSeq        Int?
  // The SENDER server's allocation time, copied verbatim from the pulled payload's `ts`. The receiver's
  // own `createdAt` (local now() at pull time) is the ARRIVAL time — what the chatbox displays and what
  // orders the conversation list. This column is the origin-faithful time, stored for future use
  // (quota day-bucketing, audit, optional origin-faithful ordering) and NEVER displayed. Nullable: null
  // for locally-authored messages (their own createdAt IS the origin time) and for pre-Step-2 legacy rows.
  originServerTime DateTime?

  mediaMessages MediaMessage[] // per-object media authz index (digest → thread)

  @@unique([threadId, seq]) // per-thread seq identity: allocation authority + keyset cursor (also the hot pagination index)
  @@unique([threadId, creator, originSeq]) // (a) sender seq allocation race AND (b) receiver pull dedup
  @@index([threadId, createdAt])
  @@index([creator])
  @@index([threadId, creator, originSeq]) // federation pull query + MAX(cursor) derivation
}

/// Content-addressed media asset (chat images / files / video / audio). One physical file per unique
/// sha256 digest at uploads/shards/<digest[0:2]>/<digest[2:4]>/<digest>.<ext>; `refs` is a
/// denormalized reference count bumped on every upload (a dedup hit lands on the same row and
/// increments refs) and decremented by a future message-delete path; the GC sweep reclaims the file
/// + row when refs reaches 0. Avatars are NOT tracked here — they keep the legacy
/// uploads/<base>-<size>.webp multi-size sharp pipeline. There is no FK to Message: Message.content
/// is an opaque JSON string and the URL embeds the digest, so the link is by-value. Internal only —
/// never surfaced in API responses (the upload routes derive {url,size,...} from the write).
///
/// Only the reference count + audit columns live here. The on-disk extension and MIME are NOT stored:
/// the extension is recoverable from the filename (<digest>.<ext>), MIME is mapped by @fastify/static
/// from the extension at serving time, and the upload response gets its MIME from the request (not
/// from this row). Storing them would be pure redundancy. The GC path globs <digest>.* to unlink.
model MediaAsset {
  digest    String   @id @db.VarChar(64) // sha256 hex (64 chars); also the on-disk filename stem
  bytes     BigInt // file size (BigInt: video cap 100MB; Int would overflow beyond ~2GB). Audit/monitoring only.
  refs      Int      @default(0) // reference count; GC reclaims file + row at 0
  createdAt DateTime @default(now())

  @@index([refs]) // GC sweep: WHERE refs <= 0
}

// Per-object media authorization index. The /uploads/shards/* gate answers "is this user allowed to read
// this digest?" with one indexed EXISTS over this table joined to ThreadParticipant. Written atomically
// at send time for every IMAGE/FILE/VIDEO/AUDIO message (one row per distinct digest a message references).
// threadId is denormalized from Message so the gate skips a JOIN to Message. Never returned in API responses.
// Per-object media authorization index. The /uploads/shards/* gate answers "is this user allowed to read
// this digest?" with one indexed EXISTS over this table joined to ThreadParticipant. 1:1 with a
// media-bearing Message: ONE message carries exactly ONE image/file/video/audio (albums are a FRONTEND
// grouping of consecutive single-image messages, never one message with many), so the Message PK IS this
// row's identity — messageId is the sole @id (no surrogate, no digest in the PK). Written at send time;
// threadId is denormalized from Message so the gate skips a JOIN. Never returned in API responses.
model MediaMessage {
  messageId BigInt   @id // == Message.id; the row's sole identity (1:1 with a media-bearing message)
  threadId  Int // denormalized from Message (the /uploads gate skips a JOIN to Message)
  digest    String   @db.VarChar(64) // sha256 hex; the CAS url stem — matches MediaAsset.digest
  createdAt DateTime @default(now())

  message Message       @relation(fields: [messageId], references: [id])
  thread  MessageThread @relation(fields: [threadId], references: [id])

  @@index([digest]) // hot gate path: WHERE digest = $D (the @id index covers messageId lookups)
  @@index([threadId])
}

/// In-flight media send/localize staging. A media message is NOT committed as a Message until its bytes
/// are confirmed — uploaded (local) or localized (federated). Until then only this row exists: no Message,
/// no seq, nothing visible in the thread. On success the row is deleted as the real Message+MediaMessage
/// are created atomically (promote). On failure it is marked `failed` and left (no auto-retry).
///
/// Created BEFORE the file write on both paths, so a crash between "intent recorded" and "bytes
/// confirmed" always leaves an attributable record: a stale `pending` row (age > GC TTL) + its linked
/// file/asset is reclaimable by the GC — never the unattributed orphan the old upload-then-send order
/// produced. `digest` is set once the bytes land and links the staging record to its MediaAsset/file.
///
/// LOCAL: clientMessageId is the optimistic-send idempotency key (originSeq NULL). The staged `content`
/// holds only client-probed display metadata (w/h, duration); the CAS url is injected at promote from
/// the server's own saveCas digest, so the real Message.content URL is never client-supplied.
/// FEDERATED: originSeq (+originDomain/originServerTime) is the pull dedup key mirroring Message's
/// @@unique([threadId, creator, originSeq]); content holds the pulled payload verbatim.
model PendingMedia {
  id               BigInt      @id @default(autoincrement())
  threadId         Int
  creatorId        Int // local sender userId; federated = foreign stub userId
  contentType      ContentType
  // LOCAL: client-probed display metadata JSON ({w,h} / {w,h,duration} / {duration} / {}); the url is
  // injected at promote. FEDERATED: the pulled content verbatim (peer's server-relative shard URL +
  // metadata) — after localization the same content-addressed path serves same-origin.
  content          String
  digest           String?     @db.VarChar(64) // set once bytes land → links staging to MediaAsset/file
  clientMessageId  String?     @unique @db.VarChar(36) // LOCAL idempotency (optimistic-send key)
  originSeq        Int? // FEDERATED provenance + pull dedup (NULL for local)
  originDomain     String?     @db.VarChar(63)
  originServerTime DateTime?
  status           String      @default("pending") @db.VarChar(12) // pending | failed
  failReason       String?     @db.VarChar(255)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  thread MessageThread @relation(fields: [threadId], references: [id])

  @@unique([threadId, creatorId, originSeq]) // federated dedup (NULL originSeq = local → many allowed)
  @@index([threadId])
  @@index([status, createdAt]) // GC stale-pending sweep
}

/// Refresh token persisted to DB (replaces an earlier in-memory map): survives restart, multi-device, revocable.
model RefreshToken {
  id           BigInt    @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique // stores sha256 hash, never the plaintext token
  jti          String    @unique // JWT id of this token; the precise revocation key, aligned with the claim
  familyId     String // minted at login, inherited across rotation; reuse-detection anchor (a replayed revoked token → whole family revoked)
  device       String? // multi-device label (the client's localStorage uuid)
  userAgent    String?   @db.VarChar(255) // UA captured at issue/rotation, shown in the session list
  ip           String?   @db.VarChar(64) // IP captured at issue/rotation, shown in the session list
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime? // soft revoke
  revokeReason String?   @db.VarChar(32) // revoke reason: logout|rotated|reuse|all_devices|password_change (observability/forensics only)

  @@index([userId])
  @@index([familyId])
}

/// Admin profile, LINKED to a User (single account namespace — no user/admin name collision possible).
/// Identity (account name + password) lives on the linked User; this row holds only admin-specific state
/// (enabled flag, last login, admin refresh-tokens). Admin login authenticates the linked User's password,
/// then issues an admin session. Admin auth stays physically isolated from user auth (separate
/// AdminRefreshToken + adminSecret + scope:'admin') — breach isolation is preserved.
/// Admin role tiers (RBAC). SUPER_ADMIN = all powers (default — the existing seed admin keeps full
/// access); ADMIN = everyday operations; VIEWER = read-only (list/view endpoints carry no @Roles, so
/// VIEWER passes AdminAuthGuard but every mutating endpoint is gated to SUPER_ADMIN / ADMIN).
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

/// Admin profile, LINKED to a User (single account namespace — no user/admin name collision possible).
/// Identity (account name + password) lives on the linked User; this row holds only admin-specific state
/// (role, enabled flag, tokenVersion for global session revocation, last login, admin refresh-tokens).
/// Admin login authenticates the linked User's password, then issues an admin session. Admin auth stays
/// physically isolated from user auth (separate AdminRefreshToken + adminSecret + scope:'admin').
model Admin {
  id            Int                 @id @default(autoincrement())
  userId        Int                 @unique
  user          User                @relation(fields: [userId], references: [id])
  role          AdminRole           @default(SUPER_ADMIN)
  enabled       Boolean             @default(true)
  tokenVersion  Int                 @default(0) // bumping this invalidates ALL of the admin's access tokens (disable / role change)
  lastLoginIp   String?             @db.VarChar(64)
  lastLoginAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  refreshTokens AdminRefreshToken[]
  actionLogs    AdminActionLog[]
}

/// Admin refresh token (family-based + reuse detection, mirrors RefreshToken; a separate instance avoids mixing with user sessions).
model AdminRefreshToken {
  id           BigInt    @id @default(autoincrement())
  adminId      Int
  admin        Admin     @relation(fields: [adminId], references: [id])
  tokenHash    String    @unique
  jti          String    @unique
  familyId     String
  userAgent    String?   @db.VarChar(255)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(32)

  @@index([adminId])
  @@index([familyId])
}

/// Append-only audit trail of admin destructive actions (who did what, from where, when, and whether it
/// succeeded). Written best-effort by AdminAuditInterceptor on handlers tagged @Audit — a log failure
/// never blocks the operation. adminRole is denormalized so history survives a later role change.
model AdminActionLog {
  id           BigInt    @id @default(autoincrement())
  adminId      Int
  admin        Admin     @relation(fields: [adminId], references: [id])
  adminRole    AdminRole
  action       String    @db.VarChar(64) // e.g. "user.disable"
  targetType   String?   @db.VarChar(32) // "user" | "peer" | "admin" …
  targetId     String?   @db.VarChar(64)
  ip           String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(255)
  route        String?   @db.VarChar(255)
  success      Boolean   @default(true)
  errorMessage String?   @db.VarChar(255)
  meta         Json?
  at           DateTime  @default(now())

  @@index([adminId])
  @@index([at])
  @@index([action])
}

// ─────────────────────────────────────────────────────────────────────────────
// Federation (S2S). See docs/federation-protocol.md. Added 2026-07-07.
// Trust model: FederatedPeer is a DOMAIN ALLOW-LIST only (no key pinning); signing
// keys are fetched from each peer's /.well-known/soms over HTTPS and cached (S2SKeyCache).
// ─────────────────────────────────────────────────────────────────────────────

/// A peer server we may federate with. The CURRENT-STATE row of the trust lifecycle (the append-only
/// transition history lives in FederatedPeerEvent). PURE DOMAIN ALLOW-LIST (trust data only — NOT keys,
/// NOT inbox URL; those are fetched from <domain>/.well-known/soms and cached by DiscoveryService).
///
/// trustLevel state machine: `pending` (seen but init not yet ok) → `trusted` (mutual trust via init)
/// → `demoted` (a trusted peer failed a signed op: cert/key change, server reset, unreachable — it
/// leaves active trust and re-handshakes on next contact, self-healing). `blocked` is an admin intent
/// that forbids federation (ensurePeerTrusted refuses to re-handshake; the inbound guard rejects it).
/// Lifecycle audit columns capture the trust→loss process for the admin timeline view.
model FederatedPeer {
  domain        String    @id @db.VarChar(63) // e.g. other.com
  trustLevel    String    @default("pending") @db.VarChar(15) // pending | trusted | demoted | blocked
  addedBy       String?   @db.VarChar(31) // admin account name who set the state, or null = auto-accepted via init
  createdAt     DateTime  @default(now()) // first discovered
  trustedAt     DateTime? // start of the current trust epoch (init ok); reset on re-trust after a demote
  lastSuccessAt DateTime? // last successful signed S2S op (liveness signal); advanced on every GET/POST ok
  demotedAt     DateTime? // last trusted→demoted transition (a failure while trusted/pending)
  demoteReason  String?   @db.VarChar(255) // latest failure message (refreshed on each failure; cleared on re-trust)
  demotionCount Int       @default(0) // how many times demoted — a flakiness signal
  blockedAt     DateTime? // admin block time

  @@index([trustLevel])
  @@index([lastSuccessAt]) // "stale / never-heard-from" peers sweep
}

/// Append-only trust-lifecycle event log — one row per state transition, the source of the admin
/// "trust → connection-loss" timeline. Decoupled from FederatedPeer (NO foreign key) so the history
/// survives any future peer-row state change and can't trigger cascade deletes; `domain` is a plain
/// indexed string. Low volume by design: only transitions are logged (discovered/trusted/demoted/
/// blocked/unblocked), not every signed op (per-op liveness is the cheap lastSuccessAt UPDATE above).
model FederatedPeerEvent {
  id        BigInt   @id @default(autoincrement())
  domain    String   @db.VarChar(63)
  type      String   @db.VarChar(15) // discovered | trusted | demoted | blocked | unblocked
  reason    String?  @db.VarChar(255) // demoted: the failure message; blocked: optional admin note
  createdAt DateTime @default(now())

  @@index([domain, createdAt])
  @@index([createdAt])
}

/// Cached peer signing keys. Fetched from <domain>/.well-known/soms (HTTPS), TTL'd by fetchedAt.
/// Multiple rows per domain during key rotation (overlapping keyIds). JWKS-style key set.
model S2SKeyCache {
  domain    String   @db.VarChar(63)
  keyId     String   @db.VarChar(127) // e.g. "other.com/key-1"
  publicKey String   @db.VarChar(127) // ed25519 public key, raw bytes base64
  fetchedAt DateTime @default(now())

  @@id([domain, keyId])
  @@index([domain])
}

/// Inbound friend-op dedup. At-least-once delivery requires idempotent dedup by (origin, opId).
model S2SFriendOpSeen {
  origin     String   @db.VarChar(63)
  opId       String   @db.VarChar(127)
  receivedAt DateTime @default(now())

  @@id([origin, opId])
}
