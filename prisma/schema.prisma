// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int               @id @default(autoincrement())
  uniqName            String            @unique @db.VarChar(127)
  avatar              String
  hashPwd             String            @db.VarChar(31)
  isForeigner         Boolean
  domain              String            @db.VarChar(63)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  isDeleted           Boolean           @default(false)
  userInfoId          Int               @unique
  userInfo            UserInfo          @relation(fields: [userInfoId], references: [id])
  userMessageThreadId Int
  userMessageThread   UserMessageThread @relation(fields: [userMessageThreadId], references: [id])

  @@unique([uniqName, domain])
}

model UserInfo {
  id             Int     @id @default(autoincrement())
  hasUrFriendReq Boolean @default(false)
  User           User?
}

model Group {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(127)
  avatar      String
  threadId    Int           @unique
  threadItem  MessageThread @relation(fields: [threadId], references: [id])
  GroupInfoId Int           @unique
  GroupInfo   GroupInfo     @relation(fields: [GroupInfoId], references: [id])
}

model GroupInfo {
  id           Int   @id @default(autoincrement())
  memberIdList Int[]
  adminIdList  Int[]

  Group Group?
}

enum MessageThreadType {
  P2P_MESSAGE
  GROUP_MESSAGE
}

enum UserMessageThreadStatus {
  PENDING
  APPROVED
  REJECTED
}

model UserMessageThread {
  id         Int                     @id @default(autoincrement())
  userId     Int
  status     UserMessageThreadStatus
  toObjType  MessageThreadType
  toObjId    Int
  threadId   Int 
  threadItem MessageThread           @relation(fields: [threadId], references: [id])
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  isDeleted  Boolean                 @default(false)
  User       User[]
}

model MessageThread {
  id                Int                 @id @default(autoincrement())
  type              MessageThreadType
  info              Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  UserMessageThread UserMessageThread[]
  Message           Message[]
  isDeleted         Boolean             @default(false)
  Group             Group?
}

enum ContentType {
  PURE_TEXT
}

model Message {
  id          BigInt        @id @default(autoincrement())
  contentType ContentType
  content     String
  threadId    Int
  creator     Int
  threadItem  MessageThread @relation(fields: [threadId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isDeleted   Boolean       @default(false)
}

enum NotifyType {
  FRIEND_REQUEST
}

model Notify {
  id      BigInt     @id @default(autoincrement())
  userId  Int
  type    NotifyType
  content Json
}
