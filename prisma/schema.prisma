// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                 @id @default(autoincrement())
  uniqName          String              @unique @db.VarChar(31)
  hashPwd           String              @db.VarChar(127)
  isForeigner       Boolean
  domain            String?             @db.VarChar(63)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  isDeleted         Boolean             @default(false)
  userExtraId       Int                 @unique
  userExtra         UserExtra           @relation(fields: [userExtraId], references: [id])
  userNotiBoxId     Int                 @unique
  userNotiBox       userNotiBox         @relation(fields: [userNotiBoxId], references: [id])
  Group             Group[]
  GroupMember       GroupMember[]
  UserMessageThread UserMessageThread[]
  refreshTokens     RefreshToken[]

  @@unique([uniqName, domain])
}

model UserExtra {
  id        Int      @id @default(autoincrement())
  name      String
  avatar    String
  User      User?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model userNotiBox {
  id             Int      @id @default(autoincrement())
  hasUrFriendReq Boolean  @default(false)
  User           User?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Group {
  id          Int           @id @default(autoincrement())
  name        String
  ownerId     Int
  owner       User          @relation(fields: [ownerId], references: [id])
  avatar      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  threadId    Int
  threadItem  MessageThread @relation(fields: [threadId], references: [id])
  GroupMember GroupMember[]
}

model GroupMember {
  id       Int   @id @default(autoincrement())
  groupId  Int
  group    Group @relation(fields: [groupId], references: [id])
  userId   Int
  userItem User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

enum MessageThreadType {
  P2P
  GROUP
}

enum UserMessageThreadStatus {
  FROM_PENDING
  TO_PENDING
  APPROVED
  BLOCKED
  DELETED
}

model UserMessageThread {
  id         Int                     @id @default(autoincrement())
  userId     Int
  userItem   User                   @relation(fields: [userId], references: [id])
  status     UserMessageThreadStatus
  toObjType  MessageThreadType
  toObjId    Int
  reqMessage String
  threadId   Int?
  threadItem MessageThread?          @relation(fields: [threadId], references: [id])
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  isDeleted  Boolean                 @default(false)
  lastRead   BigInt?

  @@unique([userId, toObjType, toObjId])
  @@unique([userId, threadId])
}

model MessageThread {
  id                Int                 @id @default(autoincrement())
  type              MessageThreadType
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  isDeleted         Boolean             @default(false)
  UserMessageThread UserMessageThread[]
  Message           Message[]
  Group             Group[]
}

enum ContentType {
  PURE_TEXT
  INVITE
  IMAGE
  VIDEO
  FILE
  AUDIO
}

model Message {
  id          BigInt        @id @default(autoincrement())
  contentType ContentType
  content     String
  threadId    Int
  creator     Int
  threadItem  MessageThread @relation(fields: [threadId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isDeleted   Boolean       @default(false)
}

enum NotifyType {
  FRIEND_REQUEST
}

model Notify {
  id        BigInt     @id @default(autoincrement())
  userId    Int
  type      NotifyType
  content   Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// refresh_token 落库（替换原内存字典）：支持重启存活、多端、可吊销
model RefreshToken {
  id         BigInt   @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique // 存 sha256 哈希，不存明文
  device     String? // 多端标识（P0 暂不填）
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime? // 软吊销

  @@index([userId])
}
