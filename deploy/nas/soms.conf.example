# ============================================================================
# SOMS INTRANET / NAS config — cp this to soms.conf and fill it in (soms.conf is
# gitignored). It's the only file you edit (docker-compose.yml is static). The `init`
# service reads it on every `docker compose up -d` and generates the rest. All fields
# below are REQUIRED — init fails fast on any missing/invalid value.
# ============================================================================
# What makes this the NAS profile (all set below):
#   SOMS_TLS_MODE=custom    HTTPS on the single 7667 port, DNS-01 wildcard cert for the domain.
#   SOMS_LAN_DOMAIN         An alternate REAL domain (own DNS-01 cert) fronting the SAME backend, so native
#                           clients reach the box from inside the LAN when the public domain is
#                           hairpin-NAT-unreachable. MUST share SOMS_DOMAIN's registrable domain (both are
#                           certified via one DNS-01 provider/zone). Replaces the old self-signed bare-IP
#                           catch-all (which broke iOS PWA: SW/Push need a trusted cert).
#   SOMS_ADMIN_ACCESS=lan   /admin + /api/v1/admin accept ONLY private-range source IPs.
# ============================================================================

# Federation identity — the <domain> in @user@<domain> handles. This NAS profile uses a REAL domain +
# DNS-01 (set below): domain access gets a trusted cert with no warning. The domain need not resolve
# publicly — it just has to exist in your DNS provider so the DNS-01 challenge can answer.
SOMS_DOMAIN=soms.example.com

# LAN domain — same backend, reachable from inside the LAN when the public domain isn't (no hairpin NAT).
# Real DNS-01 cert → trusted on all platforms incl. iOS PWA. Must share soms.example.com's apex
# (example.com). Native clients enter one domain; the server advertises the other via /shell/compat and
# the client auto-fills + confirms it, then races /api/v1/health to pick the reachable one.
SOMS_LAN_DOMAIN=soms-lan.example.com

# single-port HTTPS with a DNS-01 wildcard cert, no HTTP redirect. (standard = public 443 profile,
# disabled = plain HTTP.)
SOMS_TLS_MODE=custom

# Admin page + admin API accept only private-range IPs (10/8, 172.16/12, 192.168/16, loopback, ULA).
SOMS_ADMIN_ACCESS=lan

# Cloudflare API token (Zone:DNS:Edit) for the DNS-01 cert. Required (custom mode). Used for BOTH
# SOMS_DOMAIN and SOMS_LAN_DOMAIN (same DNS zone).
CLOUDFLARE_API_TOKEN=

# Database password. NOTE: first-run only — once postgres has initialized, the password is
# baked in; changing it here is ignored. Rotate via `ALTER USER timescale PASSWORD '…'`.
POSTGRES_PASSWORD=

# Bootstrap admin password (account=admin). Used only on first boot to seed the admin; ignored after.
ADMIN_BOOTSTRAP_PASSWORD=

# PostgreSQL connection-pool max. Keep (max × app replicas) ≤ PostgreSQL max_connections (100).
DATABASE_POOL_MAX=10

# Optional — admin WebAuthn (passkeys) overrides. Defaults: rpId = SOMS_DOMAIN; allowed origins derived
# from SOMS_DOMAIN + SOMS_TLS_MODE, plus SOMS_LAN_DOMAIN when set. Set only for unusual topologies. The
# NAS profile (custom TLS on :7667) IS a secure context, so passkeys work over both domains. If
# SOMS_DOMAIN is itself a subdomain and you need passkeys on the LAN domain too, set SOMS_WEBAUTHN_RP_ID
# to the shared apex (e.g. example.com). TOTP 2FA remains the fallback.
# SOMS_WEBAUTHN_RP_ID=example.com
# SOMS_WEBAUTHN_ALLOWED_ORIGINS=https://soms.example.com:7667

# ============================================================================
# DNS-01 provider — only edit this to use a non-default provider. {KEY} is transcribed from a
# matching VAR=... line in THIS file (do NOT inline the secret). Quote the value (it contains
# spaces; soms.conf is sourced as shell). Syntax per module:
#   https://github.com/caddy-dns/<provider>
#   Cloudflare (default): CADDY_DNS_DIRECTIVE="dns cloudflare {CLOUDFLARE_API_TOKEN}"
#   AliDNS (block):       CADDY_DNS_DIRECTIVE="dns alidns {
#                           access_key_id {ALIYUN_ACCESS_KEY_ID}
#                           access_key_secret {ALIYUN_ACCESS_KEY_SECRET}
#                         }"   (+ ALIYUN_ACCESS_KEY_ID=… / ALIYUN_ACCESS_KEY_SECRET=…)
#   Tencent Cloud (block):CADDY_DNS_DIRECTIVE="dns tencentcloud {
#                           secret_id {TENCENTCLOUD_SECRET_ID}
#                           secret_key {TENCENTCLOUD_SECRET_KEY}
#                         }"   (+ TENCENTCLOUD_SECRET_ID=… / TENCENTCLOUD_SECRET_KEY=…)
#   AWS Route 53 (env):   CADDY_DNS_DIRECTIVE="dns route53"
#                         (+ AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — read from env, no {…})
# dnspod is NOT bundled (unmaintained) — Tencent users: tencentcloud or edgeone.
# ============================================================================
# CADDY_DNS_DIRECTIVE="dns cloudflare {CLOUDFLARE_API_TOKEN}"

# ---- Advanced (optional). Any app env var may be set here: ----
# SOMS_QUOTA_DAILY_MSG_LIMIT=5000
# Local-account personal quota defaults (independent from federated-peer quotas)
# SOMS_USER_QUOTA_DAILY_MSG_LIMIT=1000
# SOMS_USER_QUOTA_DAILY_IMAGE_LIMIT=100
# SOMS_USER_QUOTA_DAILY_LARGE_FILE_LIMIT=20
# SOMS_USER_QUOTA_DAILY_REQUEST_LIMIT=50
# SOMS_USER_QUOTA_MAX_IMAGE_BYTES=20971520
# SOMS_USER_QUOTA_MAX_LARGE_FILE_BYTES=209715200
# LOG_LEVEL=info
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/firebase-sa.json
