# ============================================================================
# SOMS INTRANET / NAS config — cp this to soms.conf and fill it in (soms.conf is
# gitignored). It's the only file you edit (docker-compose.yml is static). The `init`
# service reads it on every `docker compose up -d` and generates the rest. All fields
# below are REQUIRED — init fails fast on any missing/invalid value.
# ============================================================================
# What makes this the NAS profile (all three already set below):
#   SOMS_TLS_MODE=custom       HTTPS on the single 7667 port, DNS-01 wildcard cert for the domain.
#   SOMS_ALLOW_IP_ACCESS=true  ALSO emit a self-signed catch-all site so the box is reachable by bare LAN
#                              IP. Domain access = clean (trusted cert); IP access = browser shows a cert
#                              warning you click through (cert mismatch is expected and accepted).
#   SOMS_ADMIN_ACCESS=lan      /admin + /api/v1/admin accept ONLY private-range source IPs.
# ============================================================================

# Federation identity — the <domain> in @user@<domain> handles. This NAS profile still uses a REAL
# domain + DNS-01 (set below): domain access gets a trusted cert with no warning. The domain need not
# resolve publicly — it just has to exist in your DNS provider so the DNS-01 challenge can answer.
SOMS_DOMAIN=nas.example.com

# single-port HTTPS with a DNS-01 wildcard cert, no HTTP redirect. (The only mode SOMS_ALLOW_IP_ACCESS
# supports — `standard` is the public 443 profile, `disabled` is plain HTTP.)
SOMS_TLS_MODE=custom

# Reachable by bare LAN IP via a self-signed catch-all site (browser warns on IP access; click through).
SOMS_ALLOW_IP_ACCESS=true

# Admin page + admin API accept only private-range IPs (10/8, 172.16/12, 192.168/16, loopback, ULA).
SOMS_ADMIN_ACCESS=lan

# Cloudflare API token (Zone:DNS:Edit) for the DNS-01 cert. Required (custom mode).
CLOUDFLARE_API_TOKEN=

# Database password. NOTE: first-run only — once postgres has initialized, the password is
# baked in; changing it here is ignored. Rotate via `ALTER USER timescale PASSWORD '…'`.
POSTGRES_PASSWORD=

# Bootstrap admin password (account=admin). Used only on first boot to seed the admin; ignored after.
ADMIN_BOOTSTRAP_PASSWORD=

# Prisma connection-pool max. Keep (max × app replicas) ≤ PostgreSQL max_connections (100).
DATABASE_POOL_MAX=10

# ============================================================================
# DNS-01 provider — only edit this to use a non-default provider. {KEY} is transcribed from a
# matching VAR=... line in THIS file (do NOT inline the secret). Quote the value (it contains
# spaces; soms.conf is sourced as shell). Syntax per module:
#   https://github.com/caddy-dns/<provider>
#   Cloudflare (default): CADDY_DNS_DIRECTIVE="dns cloudflare {CLOUDFLARE_API_TOKEN}"
#   AliDNS (block):       CADDY_DNS_DIRECTIVE="dns alidns {
#                           access_key_id {ALIYUN_ACCESS_KEY_ID}
#                           access_key_secret {ALIYUN_ACCESS_KEY_SECRET}
#                         }"   (+ ALIYUN_ACCESS_KEY_ID=… / ALIYUN_ACCESS_KEY_SECRET=…)
#   Tencent Cloud (block):CADDY_DNS_DIRECTIVE="dns tencentcloud {
#                           secret_id {TENCENTCLOUD_SECRET_ID}
#                           secret_key {TENCENTCLOUD_SECRET_KEY}
#                         }"   (+ TENCENTCLOUD_SECRET_ID=… / TENCENTCLOUD_SECRET_KEY=…)
#   AWS Route 53 (env):   CADDY_DNS_DIRECTIVE="dns route53"
#                         (+ AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — read from env, no {…})
# dnspod is NOT bundled (unmaintained) — Tencent users: tencentcloud or edgeone.
# ============================================================================
# CADDY_DNS_DIRECTIVE="dns cloudflare {CLOUDFLARE_API_TOKEN}"

# ---- Advanced (optional). Any app env var may be set here: ----
# SOMS_QUOTA_DAILY_MSG_LIMIT=5000
# LOG_LEVEL=info
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/firebase-sa.json
