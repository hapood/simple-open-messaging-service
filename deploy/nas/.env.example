# ============================================================================
# SOMS NAS configuration — copy to .env, edit it, then run `docker compose up -d`.
# Compose injects this file directly; it is a standard dotenv file, not a shell script.
# ============================================================================
# What makes this the NAS profile (all set below):
#   SOMS_TLS_MODE=single-port  HTTPS on the single 7667 port, DNS-01 wildcard cert for the domain.
#   SOMS_LAN_DOMAIN         An alternate REAL domain (own DNS-01 cert) fronting the SAME backend, so native
#                           clients reach the box from inside the LAN when the public domain is
#                           hairpin-NAT-unreachable. MUST share SOMS_DOMAIN's registrable domain (both are
#                           certified via one DNS-01 provider/zone). Replaces the old self-signed bare-IP
#                           catch-all (which broke iOS PWA: SW/Push need a trusted cert).
#   SOMS_ADMIN_ACCESS=lan   /admin + /api/v1/admin accept ONLY private-range source IPs.
# ============================================================================

# Federation identity — the <domain> in @user@<domain> handles. It may be the registrable apex while the
# actual Web entry point uses SOMS_WEB_DOMAIN below. All configured domains must share one DNS zone.
SOMS_DOMAIN=example.com

# Public Web/native-client entry point. Defaults to SOMS_DOMAIN when omitted. Keeping it separate lets
# handles stay @user@example.com while clients connect to https://soms.example.com:7667.
SOMS_WEB_DOMAIN=soms.example.com

# LAN domain — same backend, reachable from inside the LAN when the public domain isn't (no hairpin NAT).
# Real DNS-01 cert → trusted on all platforms incl. iOS PWA. Must share SOMS_DOMAIN's apex
# (example.com). Native clients enter one domain; the server advertises the other via /api/v1/shell/compat and
# the client auto-fills + confirms it, then races /api/v1/health to pick the reachable one.
SOMS_LAN_DOMAIN=soms-lan.example.com

# TLS/certificate mode:
#   single-port — trusted DNS-01 certificates on the single 7667 port (recommended here).
#   standard — also needs published 80/443; the NAS Compose template does not publish them.
#   disabled — plain HTTP for local testing only; passkeys and other secure-context features will not work.
SOMS_TLS_MODE=single-port

# Admin console exposure:
#   lan    — accept /admin and /api/v1/admin only from private-range source IPs (recommended here).
#   public — allow those routes from any source (authentication still required).
SOMS_ADMIN_ACCESS=lan

# Published host port. Keep 7667: native-client origins and WebAuthn still use that port;
# changing this mapping alone does not configure a custom external port throughout the app.
SOMS_PORT=7667

# Cloudflare API token (Zone:Zone:Read + Zone:DNS:Edit) for the DNS-01 cert. Required for the Cloudflare example below.
# Use DNS-only records for direct access on port 7667. Used for BOTH
# SOMS_DOMAIN and SOMS_LAN_DOMAIN (same DNS zone).
CADDY_DNS_DIRECTIVE="dns cloudflare {env.CLOUDFLARE_API_TOKEN}"
CLOUDFLARE_API_TOKEN=

# PostgreSQL database, user, and password. Initialization uses these only for a fresh volume;
# the app and migrations use them on every start. Changing only this password does not rotate the
# existing PostgreSQL role and breaks login. Rotate the role password and update this value together.
PGDATABASE=soms
PGUSER=timescale
PGPASSWORD=

# Maximum connections in the app pool. Keep `max × app-replica count` within PostgreSQL's
# max_connections.
DATABASE_POOL_MAX=10

# Production logging favors low steady-state overhead. Set LOG_LEVEL=debug temporarily when execution
# measurements are needed. Execution measurement is disabled by default; a value in (0,1] samples
# annotated business operations and durable tasks after the app container is recreated. Both settings
# are required because execution measurements are debug-level records.
LOG_LEVEL=warn
EXECUTION_MEASUREMENT_SAMPLE_RATE=0

# Bootstrap admin password (account=admin). Seeds the bootstrap admin when its role is absent;
# it does not reset an existing account's password. An empty value skips bootstrap.
ADMIN_BOOTSTRAP_PASSWORD=

# FCM (Android) uses two Firebase Console downloads placed in ./data beside this file:
#   firebase-service-account.json — private server credential used to SEND push messages. Keep it secret.
#   google-services.json          — public Android client config published through GET /api/v1/shell/compat.
# These filenames are relative to the credential directory, normally /app/data (mounted from ./data).
# There are no per-file overrides. Leave SOMS_CONFIG_DIR and SOMS_DATA_DIR unset with this template.

# Optional WebRTC connectivity. TURN runs as external infrastructure (for example coturn), not in this
# Compose stack. Set BOTH TURN values or neither; the REST secret must match coturn's static-auth-secret.
# SOMS_STUN_URLS=stun:turn.example.com:3478
# SOMS_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# SOMS_TURN_REST_SECRET=replace-with-a-long-random-secret
# SOMS_TURN_TTL=3600

# ============================================================================
# DNS-01 provider — replace the directive above to select another provider. Use native {env.KEY}
# references to variables in this file; Caddy resolves them without writing secrets into its Caddyfile.
# Do not inline credentials. Quote values containing spaces; single-quote literal dollar signs.
# Syntax per module:
#   https://github.com/caddy-dns/<provider>
#   Cloudflare: CADDY_DNS_DIRECTIVE="dns cloudflare {env.CLOUDFLARE_API_TOKEN}"
#   AliDNS (block):       CADDY_DNS_DIRECTIVE="dns alidns {
#                           access_key_id {env.ALIYUN_ACCESS_KEY_ID}
#                           access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
#                         }"   (+ ALIYUN_ACCESS_KEY_ID=… / ALIYUN_ACCESS_KEY_SECRET=…)
#   Tencent Cloud (block):CADDY_DNS_DIRECTIVE="dns tencentcloud {
#                           secret_id {env.TENCENTCLOUD_SECRET_ID}
#                           secret_key {env.TENCENTCLOUD_SECRET_KEY}
#                         }"   (+ TENCENTCLOUD_SECRET_ID=… / TENCENTCLOUD_SECRET_KEY=…)
#   AWS Route 53 (env):   CADDY_DNS_DIRECTIVE="dns route53"
#                         (+ AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — read directly from env)
# dnspod is NOT bundled (unmaintained) — Tencent users: tencentcloud or edgeone.
# ============================================================================
