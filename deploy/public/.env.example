# ============================================================================
# SOMS public configuration — copy to .env, edit it, then run `docker compose up -d`.
# Compose injects this file directly; it is a standard dotenv file, not a shell script.
# ============================================================================

# Federation identity — the <domain> in @user@<domain> handles.
SOMS_DOMAIN=example.com

# Public Web/native-client entry point. Defaults to SOMS_DOMAIN when omitted. Keeping it separate lets
# handles stay @user@example.com while clients connect to https://soms.example.com.
SOMS_WEB_DOMAIN=soms.example.com

# Optional LAN domain — an alternate REAL domain (own DNS-01 cert) fronting the SAME backend, so native
# clients can fall back to it from inside the LAN when the public domain is hairpin-NAT-unreachable.
# Must share SOMS_DOMAIN's registrable domain (same DNS-01 zone). Leave commented if unused.
# SOMS_LAN_DOMAIN=soms-lan.example.com

# TLS/certificate mode:
#   standard — trusted DNS-01 certificates; HTTPS on 443 and federation on 7667 (recommended here).
#   single-port — trusted DNS-01 certificates on the single federation port (normally used by NAS).
#   disabled — plain HTTP for local testing only; passkeys and other secure-context features will not work.
SOMS_TLS_MODE=standard

# Admin console exposure:
#   public — allow /admin and /api/v1/admin from any source (authentication still required).
#   lan    — accept those routes only from private-range source IPs.
SOMS_ADMIN_ACCESS=public

# Published host ports. Container ports remain the protocol-defined 80/443/7667.
SOMS_HTTP_PORT=80
SOMS_HTTPS_PORT=443
SOMS_FEDERATION_PORT=7667

# Cloudflare API token (Zone:DNS:Edit) for the DNS-01 cert.
# Required for single-port/standard; ignored for disabled.
CLOUDFLARE_API_TOKEN=

# PostgreSQL database, user, and password. The password is first-run only — once PostgreSQL has
# initialized its volume, changing it here is ignored. Rotate it with ALTER USER when needed.
PGDATABASE=soms
PGUSER=timescale
PGPASSWORD=

# Maximum connections in the app pool. Keep `max × app-replica count` within PostgreSQL's
# max_connections.
DATABASE_POOL_MAX=10

# Bootstrap admin password (account=admin). Used only on first boot to seed the admin; ignored after.
ADMIN_BOOTSTRAP_PASSWORD=

# Authentication abuse limits start in observation-only shadow mode. Change one policy at a time only
# after reviewing rate_limit_summary data; see docs/operations/rate-limiting.md for thresholds and gates.
# RATE_LIMIT_AUTH_PASSWORD_LOGIN_MODE=shadow
# RATE_LIMIT_AUTH_OTP_LOGIN_MODE=shadow
# RATE_LIMIT_AUTH_QR_CREATE_MODE=shadow
# RATE_LIMIT_AUTH_QR_POLL_MODE=shadow
# RATE_LIMIT_AUTH_QR_SCAN_MODE=shadow
# RATE_LIMIT_AUTH_QR_CONFIRM_MODE=shadow

# FCM (Android) uses two Firebase Console downloads placed in ./data beside this file:
#   firebase-service-account.json — private server credential used to SEND push messages. Keep it secret.
#   google-services.json          — public Android client config published through GET /shell/compat.
# These are already the application defaults because ./data is mounted at /app/data. Leave them commented;
# uncomment only when using different filenames or paths. `npm run dev` uses the same data/<filename> rule.
# GOOGLE_APPLICATION_CREDENTIALS=/app/data/firebase-service-account.json
# FIREBASE_CLIENT_CONFIG=/app/data/google-services.json

# Optional — admin WebAuthn (passkeys) overrides. Defaults: rpId = SOMS_DOMAIN; allowed origins derived
# from SOMS_DOMAIN + SOMS_TLS_MODE (+ SOMS_LAN_DOMAIN when set). Set only for unusual topologies
# (multi-subdomain / alternate port / proxy that changes the browser origin). WebAuthn is unavailable
# under SOMS_TLS_MODE=disabled (no secure context); TOTP 2FA remains the fallback.
# SOMS_WEBAUTHN_RP_ID=example.com
# SOMS_WEBAUTHN_ALLOWED_ORIGINS=https://soms.example.com

# ============================================================================
# DNS-01 provider — only edit this to use a non-default provider. {KEY} is transcribed from a
# matching VAR=... line in THIS file (do NOT inline the secret). Quote values containing spaces.
# Syntax per module:
#   https://github.com/caddy-dns/<provider>
#   Cloudflare (default): CADDY_DNS_DIRECTIVE="dns cloudflare {CLOUDFLARE_API_TOKEN}"
#   AliDNS (block):       CADDY_DNS_DIRECTIVE="dns alidns {
#                           access_key_id {ALIYUN_ACCESS_KEY_ID}
#                           access_key_secret {ALIYUN_ACCESS_KEY_SECRET}
#                         }"   (+ ALIYUN_ACCESS_KEY_ID=… / ALIYUN_ACCESS_KEY_SECRET=…)
#   Tencent Cloud (block):CADDY_DNS_DIRECTIVE="dns tencentcloud {
#                           secret_id {TENCENTCLOUD_SECRET_ID}
#                           secret_key {TENCENTCLOUD_SECRET_KEY}
#                         }"   (+ TENCENTCLOUD_SECRET_ID=… / TENCENTCLOUD_SECRET_KEY=…)
#   AWS Route 53 (env):   CADDY_DNS_DIRECTIVE="dns route53"
#                         (+ AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — read from env, no {…})
# dnspod is NOT bundled (unmaintained) — Tencent users: tencentcloud or edgeone.
# ============================================================================
# CADDY_DNS_DIRECTIVE="dns cloudflare {CLOUDFLARE_API_TOKEN}"

# ---- Advanced (optional). Any app env var may be set here: ----
# SOMS_QUOTA_DAILY_MSG_LIMIT=5000
# Local-account personal quota defaults (independent from federated-peer quotas)
# SOMS_USER_QUOTA_DAILY_MSG_LIMIT=1000
# SOMS_USER_QUOTA_DAILY_IMAGE_LIMIT=100
# SOMS_USER_QUOTA_DAILY_LARGE_FILE_LIMIT=20
# SOMS_USER_QUOTA_DAILY_REQUEST_LIMIT=50
# SOMS_USER_QUOTA_MAX_IMAGE_BYTES=20971520
# SOMS_USER_QUOTA_MAX_LARGE_FILE_BYTES=209715200
# LOG_LEVEL=info
