{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./.fed-app-build",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "test/federation-app.main.ts",
    "test/federation-harness.ts",
    "test/federation-proxy.ts",
    "test/federation-test-helpers.ts"
  ],
  "exclude": ["src/**/*.spec.ts", "test/**/*.e2e-spec.ts"]
}
