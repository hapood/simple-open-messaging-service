{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:message-feed",
  "title": "GET /s2s/v1/message-feed response data",
  "$defs": {
    "thread": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "account", "domain"],
          "properties": {
            "type": { "const": "GROUP" },
            "account": {
              "$ref": "urn:soms:federation:v1:common#/$defs/groupAccount"
            },
            "domain": { "$ref": "urn:soms:federation:v1:common#/$defs/domain" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "participants"],
          "properties": {
            "type": { "const": "P2P" },
            "participants": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "urn:soms:federation:v1:common#/$defs/address"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["feedId", "thread", "messageEndSeq"],
      "properties": {
        "feedId": {
          "$ref": "urn:soms:federation:v1:common#/$defs/positiveDecimalString"
        },
        "thread": { "$ref": "#/$defs/thread" },
        "messageEndSeq": {
          "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["items", "scannedThrough", "messageFeedEndId", "hasMore"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "scannedThrough": {
      "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
    },
    "messageFeedEndId": {
      "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
    },
    "hasMore": { "type": "boolean" }
  },
  "additionalProperties": false
}
