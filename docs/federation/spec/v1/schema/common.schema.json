{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:common",
  "title": "SOMS Federation v1 common wire scalars",
  "$defs": {
    "userAccount": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,29}$"
    },
    "groupAccount": {
      "type": "string",
      "pattern": "^![a-z0-9]{2,30}$"
    },
    "account": {
      "type": "string",
      "pattern": "^(?:[a-z0-9][a-z0-9._-]{1,29}|![a-z0-9]{2,30})$"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"
    },
    "decimalString": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "positiveDecimalString": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "epochMilliseconds": {
      "$ref": "#/$defs/safeNonNegativeInteger",
      "description": "Unix epoch milliseconds encoded as a non-negative JSON safe integer"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base64Ed25519Key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "base64Ed25519Signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "base64UrlNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,128}$"
    },
    "rootFingerprint": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "canonicalUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "callSid": {
      "$ref": "#/$defs/canonicalUuid"
    },
    "address": {
      "type": "object",
      "required": ["account", "domain"],
      "properties": {
        "account": { "$ref": "#/$defs/account" },
        "domain": { "$ref": "#/$defs/domain" }
      },
      "additionalProperties": false
    },
    "successEnvelope": {
      "type": "object",
      "required": ["code", "message", "data"],
      "properties": {
        "code": { "const": 0 },
        "message": { "type": "string" },
        "data": true
      },
      "additionalProperties": false
    }
  }
}
