{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:identity",
  "title": "Federation v1 identity claims",
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "protocolVersion",
        "originDomain",
        "recipientDomain",
        "pairwiseServerId",
        "rootKeyFingerprint",
        "nonce",
        "issuedAt"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "originDomain": {
          "$ref": "urn:soms:federation:v1:common#/$defs/domain"
        },
        "recipientDomain": {
          "$ref": "urn:soms:federation:v1:common#/$defs/domain"
        },
        "pairwiseServerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "rootKeyFingerprint": {
          "$ref": "urn:soms:federation:v1:common#/$defs/rootFingerprint"
        },
        "nonce": {
          "$ref": "urn:soms:federation:v1:common#/$defs/base64UrlNonce"
        },
        "issuedAt": {
          "$ref": "urn:soms:federation:v1:common#/$defs/epochMilliseconds"
        },
        "startChangeId": {
          "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    },
    "igniteClaim": {
      "allOf": [{ "$ref": "#/$defs/claim" }, { "required": ["startChangeId"] }]
    },
    "signedClaim": {
      "type": "object",
      "required": [
        "protocolVersion",
        "originDomain",
        "recipientDomain",
        "pairwiseServerId",
        "rootKeyFingerprint",
        "nonce",
        "issuedAt",
        "keyId",
        "signature"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "originDomain": {
          "$ref": "urn:soms:federation:v1:common#/$defs/domain"
        },
        "recipientDomain": {
          "$ref": "urn:soms:federation:v1:common#/$defs/domain"
        },
        "pairwiseServerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "rootKeyFingerprint": {
          "$ref": "urn:soms:federation:v1:common#/$defs/rootFingerprint"
        },
        "nonce": {
          "$ref": "urn:soms:federation:v1:common#/$defs/base64UrlNonce"
        },
        "issuedAt": {
          "$ref": "urn:soms:federation:v1:common#/$defs/epochMilliseconds"
        },
        "startChangeId": {
          "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
        },
        "keyId": { "type": "string", "minLength": 3 },
        "signature": {
          "$ref": "urn:soms:federation:v1:common#/$defs/base64Ed25519Signature"
        }
      },
      "additionalProperties": false
    },
    "feedRevisionHint": {
      "type": "object",
      "required": ["origin", "stateFeedRev", "messageFeedRev"],
      "properties": {
        "origin": {
          "$ref": "urn:soms:federation:v1:common#/$defs/domain"
        },
        "stateFeedRev": {
          "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
        },
        "messageFeedRev": {
          "$ref": "urn:soms:federation:v1:common#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    }
  }
}
