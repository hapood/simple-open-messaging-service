{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:forward-bundle",
  "title": "GET /s2s/v1/forward-bundles/:bundleId response data",
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["digest", "kind", "extension", "bytes"],
      "properties": {
        "digest": { "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex" },
        "kind": {
          "enum": ["avatar", "image", "file", "video", "audio", "link"]
        },
        "extension": { "type": "string" },
        "bytes": {
          "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
        },
        "filename": { "type": "string" },
        "mime": { "type": "string" }
      },
      "additionalProperties": false
    },
    "manifestMessage": {
      "type": "object",
      "required": ["sender", "contentType", "content", "sentAt"],
      "properties": {
        "id": {
          "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
        },
        "sender": {
          "type": "object",
          "required": ["displayName", "account", "domain"],
          "properties": {
            "displayName": { "type": "string" },
            "account": {
              "$ref": "urn:soms:federation:v1:common#/$defs/account"
            },
            "domain": { "$ref": "urn:soms:federation:v1:common#/$defs/domain" },
            "avatarDigest": {
              "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex"
            }
          },
          "additionalProperties": false
        },
        "contentType": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "sentAt": {
          "$ref": "urn:soms:federation:v1:common#/$defs/epochMilliseconds"
        },
        "childBundleId": { "type": "string", "minLength": 1, "maxLength": 26 },
        "quote": {
          "type": "object",
          "required": ["preview"],
          "properties": {
            "preview": { "type": "string" },
            "targetId": {
              "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "bundleId",
        "depth",
        "children",
        "messages"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "bundleId": { "type": "string", "minLength": 1, "maxLength": 26 },
        "depth": { "type": "integer", "minimum": 1, "maximum": 3 },
        "children": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 26 }
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/manifestMessage" }
        }
      },
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "required": ["id", "depth", "manifestDigest", "manifest", "assets"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 26 },
        "depth": { "type": "integer", "minimum": 1, "maximum": 3 },
        "manifestDigest": {
          "$ref": "urn:soms:federation:v1:common#/$defs/sha256Hex"
        },
        "manifest": { "$ref": "#/$defs/manifest" },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schemaVersion", "rootBundleId", "bundles", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rootBundleId": { "type": "string", "minLength": 1, "maxLength": 26 },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/bundle" }
    },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "accessContext": {
      "type": "object",
      "required": ["threadId", "seq"],
      "properties": {
        "threadId": {
          "$ref": "urn:soms:federation:v1:common#/$defs/positiveSafeInteger"
        },
        "seq": {
          "$ref": "urn:soms:federation:v1:common#/$defs/safeNonNegativeInteger"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
