{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soms:federation:v1:error",
  "title": "Federation v1 JSON error envelope",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "enum": [
        10000, 10001, 10004, 10005, 10999, 50001, 50002, 50003, 50007, 50009,
        50010, 50011, 50012, 50013, 50014, 50015, 50017, 50018, 50019, 50020,
        50021, 70001, 70004, 70007, 70008
      ]
    },
    "message": { "type": "string" },
    "data": true
  },
  "additionalProperties": false
}
