# PostgreSQL 数据库连接字符串
# 格式: postgresql://用户名:密码@主机:端口/数据库名?schema=public
# 1. 复制本文件为 .env (cp .env.example .env)
# 2. 按你的本地 PostgreSQL 环境修改下面的连接信息
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soms?schema=public"

# ===== 认证与安全（P0：密钥外置，缺失则服务启动 fail-fast）=====
# JWT access_token 签名密钥（access 短期 token + WebSocket 网关鉴权）
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
# JWT refresh_token 签名密钥（与 access 分离，建议不同值）
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
# admin 控制台 JWT 独立密钥（与用户体系物理隔离，务必不同值）
JWT_ADMIN_SECRET="change-me-to-a-different-admin-secret"
# 群组邀请 token 签名密钥
GROUP_INVITE_SECRET="change-me-to-another-long-random-string"
# admin 引导密码：仅 `node prisma/seed-admin.cjs` 首次种子首个 admin 时使用
ADMIN_BOOTSTRAP_PASSWORD="change-me-to-strong-initial-password"

