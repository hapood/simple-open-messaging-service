# PostgreSQL connection string.
# Format: postgresql://user:password@host:port/dbname?schema=public
# 1. Copy this file to .env (cp .env.example .env)
# 2. Adjust the connection details below for your local PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soms?schema=public"

# Prisma (node-pg) connection-pool max. Default 10 (pg's native default). There is now ONE pool per app
# instance (src/prisma.module.ts); keep `max × app-replica count` ≤ PostgreSQL max_connections (default 100).
# DATABASE_POOL_MAX=10

# ===== HTTP service (Fastify adapter) =====
# Listen port (Dockerfile EXPOSE 3000).
PORT=3000
# HTTP/2 over TLS: set BOTH TLS_CERT and TLS_KEY (PEM file paths) to speak ALPN h2 directly
# (for the server-is-the-edge topology). If either is missing it runs HTTP/1.1 — leave empty for
# local dev, or for production where a reverse proxy terminates TLS+h2 at the edge and origin is h1.1.
# Never enable http2 without https (= h2c, unusable by browsers).
# TLS_CERT=/etc/ssl/chat/cert.pem
# TLS_KEY=/etc/ssl/chat/key.pem


# ===== Auth & security =====
# JWT signing secrets — OPTIONAL. Leave unset (or empty) to auto-generate on first boot into
# ./data/jwt-{access,refresh,admin}.key (mode 0600) and reuse across restarts; same on-disk pattern
# as the S2S keypair. Set explicit values only for multi-instance deployments (all replicas must
# share), rotation, or an external secret store. A non-empty value always wins over the auto file.
#   JWT_ACCESS_SECRET  — access_token (short-lived) + WebSocket gateway auth
#   JWT_REFRESH_SECRET — refresh_token (separate from access; use a different value)
#   JWT_ADMIN_SECRET   — admin console (physically isolated from the user system; must differ)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
# Admin bootstrap password: used only by `node prisma/seed-admin.cjs` to seed the first admin.
ADMIN_BOOTSTRAP_PASSWORD="change-me-to-strong-initial-password"

# ===== Push (FCM + Web Push) =====
# FCM (Android/iOS): absolute path to the Firebase service-account JSON. Unset → FCM dispatch disabled (SSE-only).
# Generate via Firebase Console → Project Settings → Service Accounts → "Generate new private key".
# GOOGLE_APPLICATION_CREDENTIALS="/abs/path/to/soms-firebase-sa.json"

# Web Push (browser/PWA): VAPID keys are now managed in the admin Settings page and stored in the DB
# (SystemSetting), so enabling/rotating Web Push needs no redeploy or shell access. These env vars are a
# ONE-TIME seed only — on first boot, if the DB has no VAPID row but these are set, they are imported into
# the DB once and then ignored. For a fresh deploy, leave them unset and generate a keypair in the console.
# Unset (and no DB row) → Web Push dispatch disabled (FCM/SSE still work).
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:noreply@example.com"

# ===== Federation (S2S) =====
# This server's public domain — the domain in @user@domain handles and in /.well-known/soms.
# Required: federation is native to SOMS; every deployment has an identity. Dev: SOMS_DOMAIN=aaa.local
SOMS_DOMAIN="aaa.local"
# Path to the persisted Ed25519 S2S signing keypair (generated on first boot). BACK THIS FILE UP —
# losing it = losing this server's identity (all peers must re-approve). Default: ./data/soms-s2s-key.json
# SOMS_S2S_KEY_PATH="./data/soms-s2s-key.json"
# Peer signing-key cache TTL (seconds). Default 6h.
# SOMS_KEY_CACHE_TTL_SEC=21600
# S2SOutboxWorker poll interval (seconds). Default 5.
# SOMS_OUTBOX_POLL_SEC=5
# Per-attempt connect timeout for outbound S2S HTTP (seconds). §6.4 v4/v6 racing backstop. Default 5.
# SOMS_CONNECT_TIMEOUT_SEC=5
# Overall timeout for an outbound S2S HTTP call (connect + transfer + response, seconds). Default 10.
# SOMS_CALL_TIMEOUT_SEC=10
# dev-only: allow plain http:// for localhost federation testing (NEVER set in production).
# SOMS_ALLOW_INSECURE_HTTP=1
