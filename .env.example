# PostgreSQL connection string.
# Format: postgresql://user:password@host:port/dbname?schema=public
# 1. Copy this file to .env (cp .env.example .env)
# 2. Adjust the connection details below for your local PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soms?schema=public"

# Prisma (node-pg) connection-pool max. Default 10 (pg's native default). There is now ONE pool per app
# instance (src/prisma.module.ts); keep `max × app-replica count` ≤ PostgreSQL max_connections (default 100).
# DATABASE_POOL_MAX=10

# ===== HTTP service (Fastify adapter) =====
# Listen port (Dockerfile EXPOSE 3000).
PORT=3000
# HTTP/2 over TLS: set BOTH TLS_CERT and TLS_KEY (PEM paths) to speak ALPN h2 directly (app-as-edge).
# Leave empty for HTTP/1.1 — local dev, or production where a reverse proxy terminates TLS+h2 and the
# origin stays h1.1. Never enable http2 without https (= h2c, unusable by browsers).
# Docker `full` image: leave UNSET — Caddy is the TLS edge on :7667; the app origin is h1.1 on loopback.
# TLS_CERT=/etc/ssl/chat/cert.pem
# TLS_KEY=/etc/ssl/chat/key.pem


# ===== DNS provider (Caddy Let's Encrypt DNS-01 cert issuance) =====
# Caddy issues + renews the TLS certificate via DNS-01. The bundled Caddyfile uses Cloudflare by default
# — set this one token and you're done (no Caddyfile edit, no bind-mount). docker compose reads .env
# automatically, so this flows into the container via the compose ${CLOUDFLARE_API_TOKEN:-} reference.
CLOUDFLARE_API_TOKEN=
# Use a DIFFERENT provider? Leave CLOUDFLARE_API_TOKEN empty, edit ./Caddyfile's `tls { dns ... }` block
# to that provider's syntax (https://github.com/caddy-dns/<provider>), uncomment the Caddyfile bind-mount
# in docker-compose.yml, and set that provider's credentials here. Example — AliDNS (Alibaba Cloud / 阿里云):
# ALICLOUD_ACCESS_KEY=
# ALICLOUD_SECRET_KEY=


# ===== Auth & security =====
# JWT signing secrets — OPTIONAL. Leave unset (or empty) to auto-generate on first boot into
# ./data/jwt-{access,refresh,admin}.key (mode 0600) and reuse across restarts; same on-disk pattern
# as the S2S keypair. Set explicit values only for multi-instance deployments (all replicas must
# share), rotation, or an external secret store. A non-empty value always wins over the auto file.
#   JWT_ACCESS_SECRET  — access_token (short-lived) + SSE gateway auth
#   JWT_REFRESH_SECRET — refresh_token (separate from access; use a different value)
#   JWT_ADMIN_SECRET   — admin console (physically isolated from the user system; must differ)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
# Admin bootstrap password: initial password for the first admin (account=admin). In production this comes
# from docker-compose.yml's admin_bootstrap_password and is self-seeded by the app on startup — no manual
# step. Here (local-dev/dotenv path) it seeds via `node prisma/seed-admin.cjs`. Optional: blank just skips
# seeding (no weak default applied); set it before first run to get an admin login.
ADMIN_BOOTSTRAP_PASSWORD=

# ===== Push (FCM + Web Push) =====
# FCM (Android/iOS): absolute path to the Firebase service-account JSON. Unset → FCM dispatch disabled (SSE-only).
# Generate via Firebase Console → Project Settings → Service Accounts → "Generate new private key".
# GOOGLE_APPLICATION_CREDENTIALS="/abs/path/to/soms-firebase-sa.json"
# Web Push (browser/PWA): VAPID keys are DB-backed and managed in the admin Settings page (NOT here).
# A fresh deploy starts with Web Push disabled; generate a keypair from the admin console to enable it.

# ===== Federation (S2S) =====
# This server's public domain — the domain in @user@domain handles and in /.well-known/soms.
# Required: federation is native to SOMS; every deployment has an identity. Dev: SOMS_DOMAIN=aaa.local
SOMS_DOMAIN="aaa.local"
# Path to the persisted Ed25519 S2S signing keypair (generated on first boot). BACK THIS FILE UP —
# losing it = losing this server's identity (all peers must re-approve). Default: ./data/soms-s2s-key.json
# SOMS_S2S_KEY_PATH="./data/soms-s2s-key.json"
# Outbound S2S HTTP tuning — defaults are sensible for most deployments:
#   SOMS_KEY_CACHE_TTL_SEC=21600   # peer signing-key cache TTL (default 6h)
#   SOMS_CONNECT_TIMEOUT_SEC=5     # per-attempt connect timeout (§6.4 v4/v6 racing backstop)
#   SOMS_CALL_TIMEOUT_SEC=10       # overall call timeout (connect + transfer + response)
# Federation large-file transport (GET /get_file Range streaming). Chunk size bounds per-request memory
# AND resume granularity — a dropped chunk re-issues from its own offset, never zero. Defaults fine.
#   SOMS_MEDIA_CHUNK_BYTES=8388608          # one chunk (default 8 MiB)
#   SOMS_MEDIA_CHUNK_TIMEOUT_SEC=120        # connect + headers + one chunk body (slow-WAN tolerant)
#   SOMS_MEDIA_MAX_CHUNK_RETRIES=5          # consecutive failures → best-effort give-up (peer NOT demoted)
# dev-only: allow plain http:// for localhost federation testing (NEVER set in production).
# SOMS_ALLOW_INSECURE_HTTP=1
