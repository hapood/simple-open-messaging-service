# PostgreSQL connection string.
# Format: postgresql://user:password@host:port/dbname?schema=public
# 1. Copy this file to .env (cp .env.example .env)
# 2. Adjust the connection details below for your local PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soms?schema=public"

# Root for mutable files (media, generated keys, logs and diagnostics). Defaults to ./data.
# Give every independently writable node its own directory; never share this path between replicas.
# SOMS_DATA_DIR=/var/lib/soms

# PostgreSQL connection-pool max. Default 10; keep `max × app-replica count` within PostgreSQL's
# max_connections.
# DATABASE_POOL_MAX=10

# Boot-time DB connect retry (bounded exponential backoff + full jitter). Lets the process tolerate a
# transiently-down Postgres at boot instead of exiting at once for the orchestrator to restart; on final
# failure the error re-throws and the process exits. See DatabaseService.connectWithRetry.
# DATABASE_CONNECT_RETRIES=5
# DATABASE_CONNECT_BASE_DELAY_MS=500
# DATABASE_CONNECT_MAX_DELAY_MS=5000
# Sample business and durable-task execution measurements. 0 disables the
# AsyncLocalStorage context and database driver hooks; 1 measures every run.
# EXECUTION_MEASUREMENT_SAMPLE_RATE=0

# ===== HTTP service (Fastify adapter) =====
# Listen port (Dockerfile EXPOSE 3000).
PORT=3000
# HTTP/2 over TLS: set BOTH TLS_CERT and TLS_KEY (PEM paths) to speak ALPN h2 directly (app-as-edge).
# Leave empty for HTTP/1.1 — local dev, or production where a reverse proxy terminates TLS+h2 and the
# origin stays h1.1. Never enable http2 without https (= h2c, unusable by browsers).
# Docker `full` image: leave BOTH UNSET — Caddy is the TLS edge on :7667; startup rejects either variable
# because the app origin must remain h1.1 on loopback. In direct-edge deployments, set both or neither.
# TLS_CERT=/etc/ssl/chat/cert.pem
# TLS_KEY=/etc/ssl/chat/key.pem
# Comma-separated IPv4/IPv6 CIDR ranges allowed to supply X-Forwarded-* headers. Unset or empty means
# trust no proxy. The official Compose deployment explicitly supplies loopback for its in-container
# Caddy. Other deployments must list only their proxy's origin network; never use a trust-all range.
# Nginx on the same host: "127.0.0.0/8,::1/128"; private Docker network: e.g. "172.20.0.0/16";
# IPv6 proxy network: e.g. "fd12:3456:789a::/64".
# TRUSTED_PROXY_CIDRS="127.0.0.0/8,::1/128"

# ===== Full Docker image TLS / DNS-01 =====
# The full image runs Caddy in front of the app and generates its internal Caddy configuration from
# deployment environment variables. Cloudflare is the default DNS-01 provider; use a token limited to
# Zone:DNS:Edit. This section is for the full image, not ordinary local `npm run dev` use.
CLOUDFLARE_API_TOKEN=
#
# To use another bundled caddy-dns provider, override the directive. `{KEY}` references an environment
# variable instead of placing a secret in the directive. Provider syntax: https://github.com/caddy-dns
# CADDY_DNS_DIRECTIVE="dns cloudflare {CLOUDFLARE_API_TOKEN}"
# Examples:
# CADDY_DNS_DIRECTIVE="dns alidns {ALIYUN_ACCESS_KEY_ID} {ALIYUN_ACCESS_KEY_SECRET}"
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# Some providers read their standard credential variables directly; for example Route 53:
# CADDY_DNS_DIRECTIVE="dns route53"
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===== Auth & security =====
# Admin bootstrap password: initial password for the first admin (account=admin). In production this comes
# from the deployment .env and is self-seeded by the app on startup. Optional: blank skips seeding; set it
# before first run to get an admin login.
ADMIN_BOOTSTRAP_PASSWORD=

# ===== Push (FCM + Web Push) =====
# FCM (Android) — place both Firebase Console downloads in ./data using these fixed filenames.
# The service-account file is the private SEND credential; keep it secret. Missing → FCM dispatch disabled.
# google-services.json is the public Android client config published through GET /shell/compat.
# Restart the backend after adding or replacing either file.
#   data/firebase-service-account.json
#   data/google-services.json
# Web Push (browser/PWA): the VAPID keypair is generated once at data/vapid-key.json and is read-only.

# ===== WebRTC connectivity (optional STUN/TURN) =====
# Comma-separated RTCIceServer URLs returned to authenticated local clients. TURN is an external
# service (for example coturn); SOMS does not run it inside the app process.
# SOMS_STUN_URLS="stun:turn.example.com:3478"
# Enable TURN only by setting BOTH variables. The secret must equal coturn's static-auth-secret;
# SOMS mints per-user, time-limited TURN REST credentials and never sends the secret to clients/peers.
# SOMS_TURN_URLS="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp"
# SOMS_TURN_REST_SECRET="replace-with-a-long-random-secret"
# Credential lifetime in seconds (default 3600).
# SOMS_TURN_TTL=3600

# ===== Federation (S2S) =====
# This server's public domain — the domain in @user@domain handles and in /.well-known/soms.
# Required: federation is native to SOMS; every deployment has an identity. Dev: SOMS_DOMAIN=aaa.local
SOMS_DOMAIN="aaa.local"
# Forwarded LINK artwork and CONTACT_CARD avatars are immutable peer snapshots by default. Set to
# "rebuild" to regenerate LINK cards locally and discard contact-card avatars from received bundles.
SOMS_FEDERATION_FORWARDED_RESOURCE_POLICY="trust"
# Optional public Web/native-client entry domain. Federation handles continue to use SOMS_DOMAIN; client
# origins use this hostname. It must share SOMS_DOMAIN's registrable domain. Defaults to SOMS_DOMAIN.
# SOMS_WEB_DOMAIN="soms.aaa.local"
# The Ed25519 S2S identity is generated at data/soms-s2s-key.json. Back it up: losing it requires
# every peer to approve this server again. Runtime federation transport policy is managed in Admin.
# dev-only: allow plain http:// for localhost federation testing (NEVER set in production).
# SOMS_ALLOW_INSECURE_HTTP=1
# Optional dev-only static domain-to-origin map. This bypasses DNS/SRV for manual multi-node testing
# on a Docker network. It requires SOMS_ALLOW_INSECURE_HTTP=1. Both variables make startup fail when
# NODE_ENV=production (fail-closed; they are never silently accepted by a production process).
# SOMS_DEV_FEDERATION_ROUTES='{"bbb.local":"http://app-b:3000"}'

# Optional separate directory for persistent credentials and identity files.
# Defaults to SOMS_DATA_DIR (or ./data). Back up both directories when separated.
# SOMS_CONFIG_DIR=

# Maximum messages per account/thread preview window. Positive integer; restart to change.
THREAD_PREVIEW_LIMIT=5
