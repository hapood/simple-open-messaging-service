# PostgreSQL 数据库连接字符串
# 格式: postgresql://用户名:密码@主机:端口/数据库名?schema=public
# 1. 复制本文件为 .env (cp .env.example .env)
# 2. 按你的本地 PostgreSQL 环境修改下面的连接信息
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soms?schema=public"

# ===== HTTP 服务（Fastify adapter）=====
# 监听端口（Dockerfile EXPOSE 3000）
PORT=3000
# HTTP/2 over TLS：同时设置 TLS_CERT 与 TLS_KEY（PEM 文件路径）后，服务直接对外讲
# ALPN h2（适合服务即边缘的场景）。两者任一缺失则跑 HTTP/1.1——本地开发，或由反向代理
# 在边缘终结 TLS+h2、回源走 h1.1 的生产拓扑都应留空。切勿只设 http2 不设 https（=h2c，浏览器不可用）。
# TLS_CERT=/etc/ssl/chat/cert.pem
# TLS_KEY=/etc/ssl/chat/key.pem


# ===== 认证与安全（P0：密钥外置，缺失则服务启动 fail-fast）=====
# JWT access_token 签名密钥（access 短期 token + WebSocket 网关鉴权）
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
# JWT refresh_token 签名密钥（与 access 分离，建议不同值）
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
# admin 控制台 JWT 独立密钥（与用户体系物理隔离，务必不同值）
JWT_ADMIN_SECRET="change-me-to-a-different-admin-secret"
# 群组邀请 token 签名密钥
GROUP_INVITE_SECRET="change-me-to-another-long-random-string"
# admin 引导密码：仅 `node prisma/seed-admin.cjs` 首次种子首个 admin 时使用
ADMIN_BOOTSTRAP_PASSWORD="change-me-to-strong-initial-password"

# ===== Push (FCM + Web Push) =====
# FCM (Android/iOS): absolute path to the Firebase service-account JSON. Unset → FCM dispatch disabled (SSE-only).
# Generate via Firebase Console → Project Settings → Service Accounts → "Generate new private key".
# GOOGLE_APPLICATION_CREDENTIALS="/abs/path/to/soms-firebase-sa.json"

# Web Push (browser/PWA): VAPID key pair. Generate once via `npx web-push generate-vapid-keys`.
# Public key is also embedded in the web client (safe to expose); private key must stay server-side.
# Unset → Web Push dispatch disabled (FCM/SSE still work).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@example.com"

