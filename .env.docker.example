# SOMS docker-compose environment variables.
#
# docker-compose.yml reads these from your SHELL environment — NO .env file required:
#   POSTGRES_PASSWORD=secret SOMS_DOMAIN=chat.example.com docker compose up -d
#
# This file is a reference catalog of the variables. To use it as a .env (e.g. with a custom compose
# override that defines `env_file:`), copy and fill in real values:  cp .env.docker.example .env

# ---- Image version (keep in sync with package.json "version") ----
APP_VERSION=0.0.1

# ---- Postgres (REQUIRED) ----
POSTGRES_PASSWORD=change-me

# ---- Auth secrets (optional) ----
# Leave unset (or empty) to auto-generate on first boot into /app/data/jwt-*.key (mode 0600).
# Mount /app/data as a volume so these keys (and the S2S identity) survive redeployments, otherwise
# every user/admin is logged out on each restart. Set explicit values for multi-instance / rotation;
# a non-empty value always wins over the auto-generated file.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=

# ---- Federation (REQUIRED) ----
# This server's public DOMAIN (bare host, NO scheme) — the @user@<SOMS_DOMAIN> identity and the host
# of /.well-known/soms. e.g. chat.example.com
SOMS_DOMAIN=chat.example.com

# ---- Bootstrap admin (first deploy only) ----
# Used by: docker compose run -e ADMIN_BOOTSTRAP_PASSWORD=... --rm app node prisma/seed-admin.cjs
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ---- Optional (left commented to use defaults / disable features) ----
# DATABASE_POOL_MAX=10
# LOG_LEVEL=info
# Web Push — VAPID keys are DB-backed and managed in the admin Settings page (NOT here). A fresh deploy
# starts with Web Push disabled; generate a keypair from the admin console to enable it.
# FCM — leave unset to disable Android push via Firebase
# GOOGLE_APPLICATION_CREDENTIALS=
