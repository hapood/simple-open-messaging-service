# SOMS docker-compose environment.
# Copy to .env and fill in real values:   cp .env.docker.example .env
# Then:   docker compose up -d

# ---- Image version (keep in sync with package.json "version") ----
APP_VERSION=0.0.1

# ---- Postgres ----
POSTGRES_PASSWORD=change-me

# ---- Auth secrets (required; generate each with: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ADMIN_SECRET=change-me

# ---- Federation ----
# Your public origin, e.g. https://chat.example.com (no trailing slash).
SOMS_DOMAIN=https://chat.example.com

# ---- Bootstrap admin (first deploy only) ----
# Used by: docker compose run --rm app node prisma/seed-admin.cjs
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ---- Optional (left commented to use defaults / disable features) ----
# DATABASE_POOL_MAX=10
# LOG_LEVEL=info
# Web Push — leave unset to disable browser push
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@example.com
# FCM — leave unset to disable Android push via Firebase
# GOOGLE_APPLICATION_CREDENTIALS=
