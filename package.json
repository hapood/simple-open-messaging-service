{
  "name": "simple-open-messaging-service",
  "version": "0.1.0-alpha.0",
  "description": "A simple open messaging service for interoperable third-party clients.",
  "author": "",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "nest build && npm run build:migrations",
    "build:migrations": "tsc -p tsconfig.migrations.json",
    "build:production": "node scripts/check-version-sync.mjs && npm run build && npm run build --prefix web && npm run build --prefix admin-web && node scripts/package-web-bundle.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "npm run build && concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend:run\" \"npm run dev:frontend\"",
    "dev:backend": "npm run build && npm run dev:backend:run",
    "dev:backend:run": "node dev/federation-lab/lab.mjs --backend-only",
    "dev:frontend": "node dev/federation-lab/lab.mjs --frontend-only --dev-server",
    "dev:build": "npm run build && npm run dev:frontend:build",
    "dev:built": "npm run dev:build && concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend:run\" \"npm run dev:frontend:built\"",
    "dev:frontend:built": "node dev/federation-lab/lab.mjs --frontend-only",
    "dev:frontend:build": "npm run build:debug --prefix web && npm run build:debug --prefix admin-web && node scripts/package-web-bundle.mjs",
    "dev:reset": "node dev/federation-lab/reset.mjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "federation:conformance": "tsx scripts/federation-conformance.ts",
    "db:migrate": "tsx scripts/migrate-db.ts migrate",
    "db:baseline": "tsx scripts/migrate-db.ts baseline",
    "db:status": "tsx scripts/migrate-db.ts status"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@noble/curves": "^2.2.0",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.13",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "firebase-admin": "^14.1.0",
    "http-message-signatures": "^1.0.6",
    "icojs": "^1.0.0",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.6.1",
    "otpauth": "^9.5.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.0",
    "rotating-file-stream": "^3.2.9",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.2",
    "structured-headers": "^2.0.3",
    "tldts": "^7.4.10",
    "ulid": "^3.0.2",
    "undici": "^8.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^6.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.18.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.9"
  }
}
