{
  "name": "simple-open-messaging-service",
  "version": "0.1.0-alpha.0",
  "description": "A simple open messaging service for interoperable third-party clients.",
  "author": "",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:be",
    "build:be": "nest build && npm run build:migrations",
    "build:fe": "npm run build:development --prefix web && npm run build:development --prefix admin-web",
    "build:development": "npm run build:be && npm run build:fe",
    "build:migrations": "tsc -p tsconfig.migrations.json",
    "build:production": "node scripts/check-version-sync.mjs && npm run build && npm run build --prefix web && npm run build --prefix admin-web",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev:be": "node dev/federation-lab/lab.mjs --backend-only",
    "dev:fe": "node dev/federation-lab/lab.mjs --frontend-only --dev-server",
    "build:android:e2e": "make -C src-tauri apk-e2e-debug",
    "dev:fe:built": "node dev/federation-lab/lab.mjs --frontend-only",
    "dev:reset": "node dev/federation-lab/reset.mjs",
    "federation:test": "FED_LAB_LOG_LEVEL=info node dev/federation-lab/diagnostics/session.mjs --users-per-node=5 --groups-per-node=5 --operations=600 --operations-per-second=10 --concurrency=12 --round-size=10 --task-timeout-ms=120000 --progress-every=25 --convergence-timeout-ms=300000 --convergence-interval-ms=1000 --convergence-samples=3 --prefix=p2p --seed=random",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "dead-code": "knip --production",
    "dead-code:files": "knip --production --files",
    "check:cycles": "madge --circular --extensions ts src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "playwright test --config test/browser-e2e/playwright.config.ts",
    "test:browser:unit": "vitest run --config vitest.browser-e2e.config.ts",
    "test:cross-platform:unit": "vitest run --config vitest.cross-platform.config.ts",
    "pi:webtest": "env -u npm_config_allow_scripts pi --extension ./tools/pi-web-testing/extension/index.ts --skill ./tools/pi-web-testing/skill --tools +browser_driver",
    "test:cross-platform": "tsx test/cross-platform/run.ts",
    "federation:conformance": "tsx tools/federation-conformance/conformance.ts --spec ./spec",
    "db:migrate": "tsx scripts/migrate-db.ts migrate",
    "db:baseline": "tsx scripts/migrate-db.ts baseline",
    "db:status": "tsx scripts/migrate-db.ts status"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^2.2.0",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.44.0",
    "canonicalize": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "firebase-admin": "^14.1.0",
    "http-message-signatures": "^1.0.6",
    "https-proxy-agent": "^7.0.6",
    "icojs": "^1.0.0",
    "ipaddr.js": "^2.4.0",
    "nestjs-pino": "^4.6.1",
    "otpauth": "^9.5.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.0",
    "rotating-file-stream": "^3.2.9",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.2",
    "structured-headers": "^2.0.3",
    "tldts": "^7.4.10",
    "ulid": "^3.0.2",
    "undici": "^8.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^6.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.18.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^17.0.0",
    "knip": "^6.35.1",
    "madge": "^8.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.9"
  }
}
