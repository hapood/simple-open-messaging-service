{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The runtime image only executes the compiled JS. `.d.ts` declarations are dead weight here
    // (no consumer imports the server's types) and source maps expose the full server source inside
    // the shipped image — so neither is emitted for the production build. Type-checking still uses
    // the base tsconfig.json in the editor / CI.
    "declaration": false,
    "sourceMap": false
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "web",
    "admin-web",
    // `src-tauri` is a self-contained Tauri project (Rust + vendored plugin guest-js built by its
    // own rollup toolchain) consumed by the Angular `web` app, not by this Nest API. Its guest-js
    // imports `@tauri-apps/api`, which is not a server dependency, so it must stay out of the API
    // compilation — same boundary as the `web` / `admin-web` sibling packages above.
    "src-tauri"
  ]
}
