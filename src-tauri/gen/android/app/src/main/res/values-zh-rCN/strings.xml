<?xml version="1.0" encoding="utf-8"?>
<!-- Simplified Chinese (mainland China). Android auto-selects between values/ and values-zh-rCN/ by
     device locale, so the FGS notification resolves its string via ctx.getString(R.string.notif_fgs_running)
     with no explicit language branching. The away-notification body is server-authored (the backend
     localizes it from Accept-Language), so there is no per-locale away string here anymore. -->
<resources>
    <string name="app_name">"SOMS"</string>
    <string name="main_activity_title">"SOMS"</string>
    <string name="notif_fgs_running">"正在后台运行"</string>
    <plurals name="notif_group_summary">
        <item quantity="other">"%d 个新会话"</item>
    </plurals>
</resources>
