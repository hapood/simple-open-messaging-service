<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.soms_desktop" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Android 9–11 show the mark before the Activity starts, then hand off to the
             native continuation while the interface loads. -->
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/splash_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/splash_light_system_bars</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.Soms.VideoPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
