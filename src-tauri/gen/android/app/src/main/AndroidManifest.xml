<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- FCM notifications require POST_NOTIFICATIONS on Android 13+ (API 33). Granted at runtime via
         SomsFcm.requestNotificationPermission(), invoked from JS after first login. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground service for the native-owned realtime channel (RealtimeService, dataSync
         type). Required to start a foreground service at all (base) + the dataSync type specifically
         (Android 14+/API 34). The service is bounded by Android 15's ~6h/24h dataSync time budget. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Camera for the QR scanner (the phone side of QR sign-in — scan a desktop's QR to authorize it).
         Runtime permission is requested by tauri-plugin-barcode-scanner before opening the scanner view. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".SomsApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.soms_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Dynamic FCM: the APK ships WITHOUT google-services.json (each operator runs their own Firebase
             project). FirebaseApp is initialized manually at process start (SomsApplication → SomsFirebase)
             from server-fetched config, so remove the default FirebaseInitProvider that expects a bundled
             google-services.json (it would otherwise log "Missing google-services.json" on every launch). -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            android:exported="false"
            tools:node="remove" />
        <!-- FCM auto-init OFF at startup (there is no default FirebaseApp until SomsFirebase creates one);
             re-enabled at runtime immediately after the manual initializeApp. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM message handler. Receives data-only high-priority messages (the wake-up signal) and
             posts a per-thread local notification when the app is backgrounded. See SomsMessagingService. -->
        <service
            android:name=".SomsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The native-owned realtime channel (foreground service, dataSync type). Holds a long-lived SSE
             to /events with the session token, continuous across fg/bg, so messages arrive in near-real-time
             when FCM is unavailable; in the foreground it forwards every event to the WebView. Started/stopped
             by MainActivity.onStop/onResume based on the Settings toggle. Android 15 caps its runtime at
             ~6h/24h, after which onTimeout stops it and the WorkManager poll takes over. See RealtimeService. -->
        <service
            android:name=".RealtimeService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
