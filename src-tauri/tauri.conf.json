{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOMS",
  "version": "0.1.0",
  "identifier": "com.soms.client",
  "build": {
    "frontendDist": "../web/dist/web/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm --prefix web run start",
    "beforeBuildCommand": "npm --prefix web run build -- --project web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: media: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
